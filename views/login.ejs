<!DOCTYPE html> 
<html lang="es"> 
<head> 
    <meta charset="UTF-8"> 
    <meta name="viewport" content="width=device-width, initial-scale=1.0"> 
    <title>Login - BIODATA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="icon" href="/img/biodata-logo.svg" type="image/svg+xml">
    <script src="https://cdn.tailwindcss.com"></script> 
    <link href="/theme.css" rel="stylesheet">
    <style>
        body { font-family: "Plus Jakarta Sans", "Segoe UI", sans-serif; }
        .login-orb { position: absolute; border-radius: 50%; filter: blur(48px); pointer-events: none; }
        .login-orb.a { width: 280px; height: 280px; background: rgba(45,212,191,.18); top: -40px; left: -40px; animation: bd-orb 12s ease-in-out infinite; }
        .login-orb.b { width: 220px; height: 220px; background: rgba(56,189,248,.16); bottom: 12%; right: -30px; animation: bd-orb 14s ease-in-out infinite reverse; }
        @media (max-width: 900px) { .login-hero { display: none !important; } .login-shell { grid-template-columns: 1fr !important; } }
    </style>
</head> 
<body class="h-screen w-full overflow-hidden" style="background:#070b12"> 
    <div class="login-shell h-full grid" style="grid-template-columns: 1.05fr 0.95fr">
        <section class="login-hero relative overflow-hidden flex flex-col justify-between px-14 py-12" style="background:radial-gradient(ellipse at 20% 10%, rgba(45,212,191,.16), transparent 46%), radial-gradient(ellipse at 90% 80%, rgba(56,189,248,.12), transparent 42%), linear-gradient(180deg,#0a1424,#070b12); border-right:1px solid rgba(148,163,184,.13)">
            <div class="login-orb a"></div>
            <div class="login-orb b"></div>
            <div class="relative z-10 flex items-center gap-3">
                <img src="/img/biodata-logo.svg" alt="BIODATA" class="h-11 w-11 rounded-xl">
                <div>
                    <div class="text-sm font-bold tracking-[0.16em] text-white">BIO<span style="color:#2dd4bf">DATA</span></div>
                    <div class="text-[11px] text-slate-400 uppercase tracking-widest">Tickets · Equipos · Clientes</div>
                </div>
            </div>
            <div class="relative z-10 max-w-md">
                <h1 class="text-4xl font-bold text-white leading-tight tracking-tight mb-4">Datos que cuidan.<br>Servicio que fluye.</h1>
                <p class="text-slate-400 text-[15px] leading-relaxed">Ingresa para gestionar tickets, equipos y clientes desde un entorno más claro y profesional.</p>
            </div>
            <div class="relative z-10 text-xs text-slate-500">Biodata · Sistema de tickets</div>
        </section>

        <section class="flex items-center justify-center p-8">
            <div class="w-full max-w-md page-enter">
                <div class="mb-8">
                    <h2 class="text-2xl font-bold text-white tracking-tight">Bienvenido</h2>
                    <p class="text-slate-400 text-sm mt-1">Ingresa a tu cuenta para continuar</p> 
                </div>
                
                <% if (locals.error) { %>
                    <div class="bg-red-500/20 border border-red-500/50 text-red-200 text-sm px-4 py-3 rounded-xl mb-6 text-center">
                        <%= error %>
                    </div>
                <% } %>

                <form action="/auth/login" method="POST" class="space-y-5"> 
                    <div> 
                        <label class="block text-xs font-medium text-slate-400 mb-1 uppercase tracking-wider">Correo electrónico</label> 
                        <input type="email" name="email" required class="w-full bg-slate-950/50 border border-slate-700 rounded-xl px-4 py-3 text-white focus:ring-2 focus:ring-teal-400 outline-none transition-all" placeholder="admin@biohertz.com"> 
                    </div> 
                    <div> 
                        <label class="block text-xs font-medium text-slate-400 mb-1 uppercase tracking-wider">Contraseña</label> 
                        <input type="password" name="password" required class="w-full bg-slate-950/50 border border-slate-700 rounded-xl px-4 py-3 text-white focus:ring-2 focus:ring-teal-400 outline-none transition-all" placeholder="••••••••"> 
                    </div> 
                    <button type="submit" class="w-full font-semibold py-3 rounded-xl transition-all" style="background:linear-gradient(180deg,#2dd4bf,#14b8a6);color:#042f2e;box-shadow:0 10px 24px -10px rgba(20,184,166,.7)"> 
                        Iniciar Sesión 
                    </button> 
                </form> 
                <div class="relative my-6"> 
                    <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-white/10"></div></div> 
                    <div class="relative flex justify-center text-xs uppercase"><span class="px-2 text-slate-500" style="background:#070b12">O continúa con</span></div> 
                </div> 
                <a href="/auth/google" class="flex items-center justify-center gap-3 w-full bg-white text-slate-900 font-medium py-3 rounded-xl hover:bg-slate-100 transition-colors"> 
                    <img src="https://www.svgrepo.com/show/475656/google-color.svg" alt="Google" class="w-5 h-5 block"> 
                    <span>Google</span> 
                </a>
            </div>
        </section>
    </div>
</body>
</html>
