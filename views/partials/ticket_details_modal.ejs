<script>
let currentTicketId = null;
let currentTicketStatus = null;
let currentTicket = null;

const TICKET_PHASES = [
    { 
        id: 'ingresado', 
        label: 'Ingresado', 
        icon: 'ph-file-text',
        style: {
            active: 'bg-slate-500 ring-slate-500 shadow-slate-500/30',
            completed: 'text-slate-400 border-slate-500/50',
            text: 'text-slate-400',
            badge: 'bg-slate-500/10 text-slate-400 border border-slate-500/20'
        }
    },
    { 
        id: 'diagnostico', 
        label: 'Diagnóstico', 
        icon: 'ph-stethoscope',
        style: {
            active: 'bg-blue-500 ring-blue-500 shadow-blue-500/30',
            completed: 'text-blue-400 border-blue-500/50',
            text: 'text-blue-400',
            badge: 'bg-blue-500/10 text-blue-400 border border-blue-500/20'
        }
    },
    { 
        id: 'presupuesto', 
        label: 'Presupuesto', 
        icon: 'ph-currency-dollar',
        style: {
            active: 'bg-amber-500 ring-amber-500 shadow-amber-500/30',
            completed: 'text-amber-400 border-amber-500/50',
            text: 'text-amber-400',
            badge: 'bg-amber-500/10 text-amber-400 border border-amber-500/20'
        }
    },
    { 
        id: 'reparacion', 
        label: 'Reparación', 
        icon: 'ph-wrench',
        style: {
            active: 'bg-orange-500 ring-orange-500 shadow-orange-500/30',
            completed: 'text-orange-400 border-orange-500/50',
            text: 'text-orange-400',
            badge: 'bg-orange-500/10 text-orange-400 border border-orange-500/20'
        }
    },
    { 
        id: 'observacion', 
        label: 'Observación', 
        icon: 'ph-eye',
        style: {
            active: 'bg-purple-500 ring-purple-500 shadow-purple-500/30',
            completed: 'text-purple-400 border-purple-500/50',
            text: 'text-purple-400',
            badge: 'bg-purple-500/10 text-purple-400 border border-purple-500/20'
        }
    },
    { 
        id: 'terminado', 
        label: 'Terminado', 
        icon: 'ph-check-circle',
        style: {
            active: 'bg-emerald-500 ring-emerald-500 shadow-emerald-500/30',
            completed: 'text-emerald-400 border-emerald-500/50',
            text: 'text-emerald-400',
            badge: 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
        }
    }
];

async function updateTicketStatus(newStatus) {
    if (!currentTicketId) return;
    
    // Pedir comentario opcional
    const comentario = prompt(`¿Cambiar estado a "${newStatus.toUpperCase()}"?\n\nIngresa un comentario (opcional):`);
    if (comentario === null) return; // Cancelado por el usuario

    try {
        const res = await fetch(`/tickets/${currentTicketId}/estado`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
                estado: newStatus,
                comentario: comentario 
            })
        });
        
        if (res.ok) {
            const data = await res.json();
            currentTicketStatus = data.ticket.estado;
            
            // Actualizar etiqueta en modal
            let statusToUse = currentTicketStatus;
            if (currentTicketStatus === 'pendiente') statusToUse = 'ingresado';
            if (currentTicketStatus === 'en_proceso') statusToUse = 'reparacion';
            if (currentTicketStatus === 'hecho') statusToUse = 'terminado';
            
            const phaseObj = TICKET_PHASES.find(p => p.id === statusToUse);
            document.getElementById('ticket-details-estado').textContent = phaseObj ? phaseObj.label : currentTicketStatus;
            
            renderPipeline(currentTicketStatus);
            
            // Actualizar fila en la lista si existe
            const listBadge = document.getElementById(`ticket-status-badge-${currentTicketId}`);
            if (listBadge) {
                const isTerminado = statusToUse === 'terminado' || statusToUse === 'hecho';
                listBadge.textContent = isTerminado ? 'Terminado' : 'Activo';
                listBadge.className = isTerminado 
                    ? 'inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium border w-fit bg-emerald-500/10 text-emerald-400 border-emerald-500/40'
                    : 'inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium border w-fit bg-amber-500/10 text-amber-400 border-amber-500/40';
            }

            // Recargar historial para ver el cambio
            loadTicketHistory(currentTicketId);
            
            // Si hubo comentario, recargar comentarios
            if (comentario && comentario.trim()) {
                loadTicketComments(currentTicketId);
            }
        } else {
            alert('Error al actualizar estado');
        }
    } catch (e) {
        console.error(e);
        alert('Error de conexión');
    }
}

function renderPipeline(currentStatus) {
    const container = document.getElementById('ticket-pipeline');
    if (!container) return;
    container.innerHTML = '';

    // Mapeo simple para estados antiguos
    let statusToUse = currentStatus;
    if (currentStatus === 'pendiente') statusToUse = 'ingresado';
    if (currentStatus === 'en_proceso') statusToUse = 'reparacion';
    if (currentStatus === 'hecho') statusToUse = 'terminado';

    const currentIndex = TICKET_PHASES.findIndex(p => p.id === statusToUse);
    // Si no coincide (ej. estado legacy raro), default a 0
    const activeIndex = currentIndex === -1 ? 0 : currentIndex;

    TICKET_PHASES.forEach((phase, index) => {
        const isCompleted = index < activeIndex;
        const isActive = index === activeIndex;
        
        const step = document.createElement('div');
        step.className = `flex flex-col items-center gap-1 relative z-10 cursor-pointer group`;
        step.onclick = () => updateTicketStatus(phase.id);

        let circleClass = '';
        let iconClass = '';
        let textClass = '';

        if (isActive) {
            circleClass = `w-8 h-8 rounded-full flex items-center justify-center text-white shadow-lg ring-2 ring-offset-2 ring-offset-slate-900 transition-all transform scale-110 ${phase.style.active}`;
            iconClass = `ph ${phase.icon} text-lg`;
            textClass = `text-[10px] font-bold mt-1 uppercase tracking-wide ${phase.style.text}`;
        } else if (isCompleted) {
            circleClass = `w-8 h-8 rounded-full flex items-center justify-center bg-slate-800 border hover:bg-slate-700 transition-colors ${phase.style.completed}`;
            iconClass = `ph ${phase.icon} text-lg`;
            textClass = `text-[10px] font-medium text-slate-400 mt-1 group-hover:text-slate-300`;
        } else {
            // Future
            circleClass = `w-8 h-8 rounded-full flex items-center justify-center bg-slate-800/50 text-slate-600 border border-slate-700 hover:border-slate-600 hover:text-slate-500 transition-colors`;
            iconClass = `ph ${phase.icon} text-lg`;
            textClass = `text-[10px] font-medium text-slate-600 mt-1`;
        }

        step.innerHTML = `
            <div class="${circleClass}">
                <i class="${iconClass}"></i>
            </div>
            <span class="${textClass}">${phase.label}</span>
        `;
        
        container.appendChild(step);
    });
    
    // Dibujar linea de fondo
    const line = document.createElement('div');
    line.className = 'absolute top-4 left-0 w-full h-0.5 bg-slate-800 -z-0';
    container.style.position = 'relative'; // Asegurar posicionamiento
    container.insertBefore(line, container.firstChild);
}

function setTicketEditMode(editing) {
    const viewIds = ['ticket-details-title', 'ticket-details-asignado', 'ticket-details-descripcion'];
    const editIds = ['ticket-edit-title', 'ticket-edit-asignado', 'ticket-edit-descripcion'];
    viewIds.forEach(id => { const el = document.getElementById(id); if (el) el.classList.toggle('hidden', editing); });
    editIds.forEach(id => { const el = document.getElementById(id); if (el) el.classList.toggle('hidden', !editing); });

    const editBtn = document.getElementById('ticket-edit-btn');
    const saveBtn = document.getElementById('ticket-edit-save');
    const cancelBtn = document.getElementById('ticket-edit-cancel');
    if (editBtn) editBtn.classList.toggle('hidden', editing);
    if (saveBtn) saveBtn.classList.toggle('hidden', !editing);
    if (cancelBtn) cancelBtn.classList.toggle('hidden', !editing);
}

function enterTicketEditMode() {
    if (!currentTicket) return;
    const titleInput = document.getElementById('ticket-edit-title');
    const descInput = document.getElementById('ticket-edit-descripcion');
    const asignadoSelect = document.getElementById('ticket-edit-asignado');
    if (titleInput) titleInput.value = currentTicket.titulo || '';
    if (descInput) descInput.value = currentTicket.descripcion || '';
    if (asignadoSelect) asignadoSelect.value = currentTicket.asignado_a != null ? String(currentTicket.asignado_a) : '';
    setTicketEditMode(true);
}

function cancelTicketEditMode() {
    setTicketEditMode(false);
}

function closeTicketDetails() {
    cancelTicketEditMode();
    document.getElementById('ticket-details-modal').classList.add('hidden');
}

async function saveTicketEdits() {
    if (!currentTicketId) return;
    const titleInput = document.getElementById('ticket-edit-title');
    const descInput = document.getElementById('ticket-edit-descripcion');
    const asignadoSelect = document.getElementById('ticket-edit-asignado');

    const nuevoTitulo = titleInput ? titleInput.value.trim() : '';
    if (!nuevoTitulo) {
        alert('El título no puede estar vacío.');
        return;
    }

    const payload = {
        titulo: nuevoTitulo,
        descripcion: descInput ? descInput.value : '',
        asignado_a: asignadoSelect && asignadoSelect.value ? asignadoSelect.value : null
    };

    const saveBtn = document.getElementById('ticket-edit-save');
    if (saveBtn) { saveBtn.disabled = true; saveBtn.textContent = 'Guardando...'; }

    try {
        const res = await fetch(`/tickets/${currentTicketId}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(payload)
        });
        if (!res.ok) {
            alert('Error al guardar los cambios');
            return;
        }
        // Refrescar datos del ticket y la lista para reflejar los cambios
        window.location.reload();
    } catch (e) {
        console.error(e);
        alert('Error de conexión');
    } finally {
        if (saveBtn) { saveBtn.disabled = false; saveBtn.textContent = 'Guardar cambios'; }
    }
}

async function openTicketDetails(id) {
    currentTicketId = id;
    try {
        const res = await fetch(`/tickets/${id}`);
        if (!res.ok) {
            alert('Error al cargar el ticket');
            return;
        }
        const t = await res.json();
        currentTicket = t;
        // Asegurar que el modal arranque en modo lectura
        cancelTicketEditMode();
        document.getElementById('ticket-details-title').textContent = t.titulo || '';
        const asignadoEl = document.getElementById('ticket-details-asignado');
        if (asignadoEl) asignadoEl.textContent = t.asignado_a_nombre || 'Sin asignar';
        
        // Actualizar estado global y renderizar pipeline
        currentTicketStatus = t.estado || 'ingresado';
        
        let statusToUse = currentTicketStatus;
        if (currentTicketStatus === 'pendiente') statusToUse = 'ingresado';
        if (currentTicketStatus === 'en_proceso') statusToUse = 'reparacion';
        if (currentTicketStatus === 'hecho') statusToUse = 'terminado';
        
        const phaseObj = TICKET_PHASES.find(p => p.id === statusToUse);
        document.getElementById('ticket-details-estado').textContent = phaseObj ? phaseObj.label : currentTicketStatus;
        
        renderPipeline(currentTicketStatus);

        document.getElementById('ticket-details-codigo').textContent = t.codigo || '-';
        const tipoMap = {
            mantencion_preventiva: 'M. Preventiva (MP)',
            mantencion_correctiva: 'M. Correctiva (MC)',
            visita_tecnica: 'Visita Técnica (VT)',
            reparacion: 'Reparación (R)',
            otro: 'Otro (O)',
            mantencion: 'Mantención (Legacy)', 
            garantia: 'Garantía (Legacy)'
        };
        document.getElementById('ticket-details-tipo').textContent = tipoMap[t.tipo] || (t.tipo || '-');
        document.getElementById('ticket-details-equipo-marca').textContent = t.equipo_marca || '-';
        document.getElementById('ticket-details-equipo-modelo').textContent = t.equipo_modelo || '-';
        document.getElementById('ticket-details-equipo-serie').textContent = t.equipo_serie || '-';
        const contactoText = [t.lugar_instalacion, t.telefono_contacto].filter(Boolean).join(' - ');
        document.getElementById('ticket-details-contacto').textContent = contactoText || '-';
        document.getElementById('ticket-details-descripcion').textContent = t.descripcion || 'Sin descripción';

        const cliBtn = document.getElementById('ticket-details-cliente-link');
        if (cliBtn) {
            const clienteId = t.cliente_id || t.equipo_cliente_id;
            cliBtn.textContent = t.cliente_nombre || t.equipo_cliente_nombre || 'Sin cliente';
            cliBtn.disabled = !clienteId;
            cliBtn.onclick = function () {
                if (clienteId && typeof openClienteRelacion === 'function') openClienteRelacion(clienteId);
            };
        }
        const eqBtn = document.getElementById('ticket-details-equipo-link');
        if (eqBtn) {
            const eqLabel = [t.equipo_nombre, t.equipo_marca, t.equipo_modelo].filter(Boolean).join(' · ') || t.equipo_serie || 'Sin equipo';
            eqBtn.textContent = eqLabel;
            eqBtn.disabled = !t.equipo_id;
            eqBtn.onclick = function () {
                if (t.equipo_id && typeof openDetalleEquipo === 'function') openDetalleEquipo(t.equipo_id);
            };
        }
        
        // Cargar historial y comentarios
        if (typeof loadTicketHistory === 'function') loadTicketHistory(id);
        if (typeof loadTicketComments === 'function') loadTicketComments(id);

        const ticketModal = document.getElementById('ticket-details-modal');
        if (typeof focusOverlay === 'function') focusOverlay(ticketModal);
        else if (ticketModal) ticketModal.classList.remove('hidden');
    } catch (e) {
        console.error(e);
        alert('Error de conexión');
    }
}

async function loadTicketHistory(id) {
    const container = document.getElementById('ticket-history');
    if (!container) return;
    container.innerHTML = '<p class="text-xs text-slate-500">Cargando historial...</p>';
    try {
        const res = await fetch(`/tickets/${id}/historial`);
        if (!res.ok) {
            console.error('Error fetching history:', res.status, res.statusText);
            container.innerHTML = `<p class="text-xs text-red-400">No se pudo cargar el historial (${res.status}).</p>`;
            return;
        }
        const historial = await res.json();
        if (!historial || historial.length === 0) {
            container.innerHTML = '<p class="text-xs text-slate-500">Sin cambios registrados.</p>';
            return;
        }
        container.innerHTML = '';
        historial.forEach(h => {
            const fecha = h.creado_en ? new Date(h.creado_en) : null;
            const usuario = h.usuario_nombre || 'Usuario';
            
            const linea = document.createElement('div');
            linea.className = 'text-xs text-slate-300 flex flex-col border border-slate-800 rounded-md px-3 py-2 bg-slate-900/60 mb-2 last:mb-0';
            
            const header = document.createElement('div');
            header.className = 'flex justify-between items-center mb-1';
            
            const left = document.createElement('div');
            left.className = 'flex items-center gap-2';
            
            const userSpan = document.createElement('span');
            userSpan.className = 'font-medium text-slate-200';
            userSpan.textContent = usuario;
            left.appendChild(userSpan);

            if (h.tipo_item === 'comentario') {
                 const badge = document.createElement('span');
                 badge.className = 'px-1.5 py-0.5 rounded text-[10px] bg-blue-500/10 text-blue-400 border border-blue-500/20';
                 badge.textContent = 'COMENTARIO';
                 left.appendChild(badge);
                 
                 if (h.fase) {
                    const phaseInfo = TICKET_PHASES.find(p => p.id === h.fase);
                    if (phaseInfo) {
                        const phaseBadge = document.createElement('span');
                        phaseBadge.className = `px-1.5 py-0.5 rounded text-[10px] border ${phaseInfo.style.badge}`;
                        phaseBadge.textContent = phaseInfo.label;
                        left.appendChild(phaseBadge);
                    }
                 }
            } else {
                const tipoLabel = h.tipo_cambio === 'estado' ? 'CAMBIO DE ESTADO' : (h.tipo_cambio === 'asignacion' ? 'ASIGNACIÓN' : h.tipo_cambio.toUpperCase());
                const badge = document.createElement('span');
                badge.className = 'px-1.5 py-0.5 rounded text-[10px] bg-slate-700 text-slate-300 border border-slate-600';
                badge.textContent = tipoLabel;
                left.appendChild(badge);
            }
            
            header.appendChild(left);
            
            const right = document.createElement('span');
            right.className = 'text-[11px] text-slate-500';
            right.textContent = fecha ? fecha.toLocaleString() : '';
            header.appendChild(right);
            
            const detalle = document.createElement('div');
            detalle.className = 'text-xs text-slate-300 mt-1 pl-1 border-l-2 border-slate-700';
            
            if (h.tipo_item === 'comentario') {
                detalle.className = 'text-xs text-slate-200 mt-1 whitespace-pre-wrap bg-slate-950/50 p-2 rounded border border-slate-800/50';
                detalle.textContent = h.valor_nuevo || ''; // En query mapeamos contenido a valor_nuevo
            } else {
                const antes = h.valor_anterior || '-';
                const despues = h.valor_nuevo || '-';
                detalle.innerHTML = `<span class="text-slate-500">${antes}</span> <i class="ph ph-arrow-right mx-1 text-slate-600"></i> <span class="text-slate-200 font-medium">${despues}</span>`;
            }
            
            linea.appendChild(header);
            linea.appendChild(detalle);
            container.appendChild(linea);
        });
    } catch (e) {
        console.error(e);
        container.innerHTML = '<p class="text-xs text-red-400">Error al cargar historial.</p>';
    }
}

async function loadTicketComments(id) {
    const container = document.getElementById('ticket-comments');
    if (!container) return;
    container.innerHTML = '<p class="text-xs text-slate-500">Cargando comentarios...</p>';
    try {
        const res = await fetch(`/tickets/${id}/comentarios`);
        if (!res.ok) {
            console.error('Error fetching comments:', res.status, res.statusText);
            container.innerHTML = `<p class="text-xs text-red-400">No se pudieron cargar los comentarios (${res.status}).</p>`;
            return;
        }
        const comentarios = await res.json();
        if (!comentarios || comentarios.length === 0) {
            container.innerHTML = '<p class="text-xs text-slate-500 italic">No hay comentarios.</p>';
            return;
        }
        container.innerHTML = '';
        comentarios.forEach(c => {
            const item = document.createElement('div');
            item.className = 'border border-slate-800 rounded-lg px-3 py-2 bg-slate-900/60';
            
            const header = document.createElement('div');
            header.className = 'flex justify-between items-center mb-1';
            
            const leftHeader = document.createElement('div');
            leftHeader.className = 'flex items-center gap-2';
            
            const autor = document.createElement('span');
            autor.className = 'text-xs font-medium text-slate-200';
            autor.textContent = c.autor_nombre || 'Usuario';
            leftHeader.appendChild(autor);

            if (c.fase) {
                const badge = document.createElement('span');
                // Encontrar info de fase para color
                const phaseInfo = TICKET_PHASES.find(p => p.id === c.fase);
                const badgeClass = phaseInfo ? phaseInfo.style.badge : 'bg-slate-500/10 text-slate-400 border-slate-500/20';
                badge.className = `text-[10px] px-1.5 py-0.5 rounded-full border uppercase tracking-wider ${badgeClass}`;
                badge.textContent = phaseInfo ? phaseInfo.label : c.fase;
                leftHeader.appendChild(badge);
            }

            const fecha = document.createElement('span');
            fecha.className = 'text-[11px] text-slate-500';
            const f = c.creado_en ? new Date(c.creado_en) : null;
            fecha.textContent = f ? f.toLocaleString() : '';
            
            header.appendChild(leftHeader);
            header.appendChild(fecha);
            
            const cuerpo = document.createElement('p');
            cuerpo.className = 'text-xs text-slate-200 whitespace-pre-wrap';
            cuerpo.textContent = c.contenido || '';
            item.appendChild(header);
            item.appendChild(cuerpo);
            container.appendChild(item);
        });
    } catch (e) {
        console.error(e);
        container.innerHTML = '<p class="text-xs text-red-400">Error al cargar comentarios.</p>';
    }
}

document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('add-comment-form');
    if (!form) return;
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const textarea = document.getElementById('comment-content');
        if (!textarea || !currentTicketId) return;
        const contenido = textarea.value.trim();
        if (!contenido) return;
        try {
            const res = await fetch(`/tickets/${currentTicketId}/comentarios`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ 
                    contenido,
                    fase: currentTicketStatus // Enviar la fase actual
                })
            });
            if (!res.ok) {
                alert('Error al agregar comentario');
                return;
            }
            textarea.value = '';
            await loadTicketComments(currentTicketId);
        } catch (e) {
            console.error(e);
            alert('Error de conexión');
        }
    });
});
</script>

<div id="ticket-details-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm hidden z-50 flex items-center justify-center overflow-y-auto py-4 px-4">
    <div class="bg-slate-900 border border-slate-700 rounded-2xl w-full max-w-6xl p-6 shadow-2xl my-auto">
        <div class="flex justify-between items-start mb-4 gap-4">
            <div class="flex-1 min-w-0">
                <h3 id="ticket-details-title" class="text-xl font-bold text-white truncate"></h3>
                <input id="ticket-edit-title" type="text" class="hidden w-full bg-slate-800 border border-slate-600 rounded-lg px-3 py-2 text-lg font-bold text-white focus:outline-none focus:border-blue-500" placeholder="Título del ticket">
                <div class="flex gap-4 mt-1 flex-wrap">
                    <p class="text-xs text-slate-400">
                        Estado: <span id="ticket-details-estado" class="font-medium text-slate-200"></span>
                    </p>
                    <p class="text-xs text-slate-400">
                        Código: <span id="ticket-details-codigo" class="font-medium text-slate-200"></span>
                    </p>
                    <p class="text-xs text-slate-400">
                        Tipo: <span id="ticket-details-tipo" class="font-medium text-slate-200"></span>
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2 shrink-0">
                <button type="button" id="ticket-edit-btn" onclick="enterTicketEditMode()" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-medium border border-slate-600/60 transition-colors">
                    <i class="ph ph-pencil-simple"></i> Editar
                </button>
                <button type="button" class="text-slate-400 hover:text-white transition-colors" onclick="closeTicketDetails()">
                    <i class="ph ph-x text-lg"></i>
                </button>
            </div>
        </div>

        <!-- Pipeline de Fases -->
        <div class="mb-6 overflow-x-auto pb-2 scrollbar-thin scrollbar-thumb-slate-700 scrollbar-track-slate-800/50">
            <div id="ticket-pipeline" class="flex items-center justify-between min-w-[600px] px-2">
                <!-- Se llena dinámicamente con JS -->
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Columna Izquierda: Información y Descripción -->
            <div class="space-y-6">
                <div class="bg-slate-800/30 rounded-lg p-4 border border-slate-700/50">
                    <div class="grid grid-cols-2 gap-4 text-sm">
                        <div>
                            <p class="text-xs text-slate-500 uppercase tracking-wider mb-0.5">Marca</p>
                            <p id="ticket-details-equipo-marca" class="text-slate-200 font-medium"></p>
                        </div>
                        <div>
                            <p class="text-xs text-slate-500 uppercase tracking-wider mb-0.5">Modelo</p>
                            <p id="ticket-details-equipo-modelo" class="text-slate-200 font-medium"></p>
                        </div>
                        <div>
                            <p class="text-xs text-slate-500 uppercase tracking-wider mb-0.5">Serie</p>
                            <p id="ticket-details-equipo-serie" class="text-slate-200 font-medium"></p>
                        </div>
                        <div>
                            <p class="text-xs text-slate-500 uppercase tracking-wider mb-0.5">Contacto</p>
                            <p id="ticket-details-contacto" class="text-slate-200 font-medium"></p>
                        </div>
                        <div>
                            <p class="text-xs text-slate-500 uppercase tracking-wider mb-0.5">Cliente</p>
                            <button type="button" id="ticket-details-cliente-link" class="text-teal-300 hover:text-cyan-300 font-medium text-left disabled:text-slate-400 disabled:hover:text-slate-400"></button>
                        </div>
                        <div>
                            <p class="text-xs text-slate-500 uppercase tracking-wider mb-0.5">Equipo</p>
                            <button type="button" id="ticket-details-equipo-link" class="text-teal-300 hover:text-cyan-300 font-medium text-left disabled:text-slate-400 disabled:hover:text-slate-400"></button>
                        </div>
                        <div class="col-span-2">
                            <p class="text-xs text-slate-500 uppercase tracking-wider mb-0.5">Responsable</p>
                            <p id="ticket-details-asignado" class="text-slate-200 font-medium"></p>
                            <select id="ticket-edit-asignado" class="hidden w-full mt-1 bg-slate-800 border border-slate-600 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-blue-500">
                                <option value="">Sin asignar</option>
                                <% if (typeof usuarios !== 'undefined') { %>
                                    <% usuarios.forEach(u => { %>
                                        <option value="<%= u.id %>"><%= u.nombre %></option>
                                    <% }); %>
                                <% } %>
                            </select>
                        </div>
                    </div>
                </div>

                <div>
                    <h4 class="text-sm font-semibold text-white mb-2 flex items-center gap-2">
                        <i class="ph ph-text-align-left text-slate-400"></i> Descripción
                    </h4>
                    <div class="bg-slate-900/50 rounded-lg p-3 border border-slate-800 min-h-[100px]">
                        <p id="ticket-details-descripcion" class="text-slate-300 whitespace-pre-wrap text-sm leading-relaxed"></p>
                        <textarea id="ticket-edit-descripcion" rows="5" class="hidden w-full bg-slate-800 border border-slate-600 rounded-lg p-2 text-white text-sm focus:outline-none focus:border-blue-500 placeholder-slate-500" placeholder="Descripción del ticket"></textarea>
                    </div>
                </div>
            </div>

            <!-- Columna Derecha: Historial y Comentarios -->
            <div class="space-y-6 flex flex-col h-full">
                <div class="flex-1 flex flex-col min-h-[200px]">
                    <h4 class="text-sm font-semibold text-white mb-2 flex items-center gap-2">
                        <i class="ph ph-chat-circle-text text-slate-400"></i> Comentarios
                    </h4>
                    <div id="ticket-comments" class="flex-1 overflow-y-auto bg-slate-900/50 rounded-lg border border-slate-800 p-3 space-y-3 mb-3 max-h-[300px]"></div>
                    <form id="add-comment-form" class="space-y-2 mt-auto">
                        <textarea id="comment-content" rows="2" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-3 text-white focus:outline-none focus:border-blue-500 text-sm placeholder-slate-500 transition-colors" placeholder="Escribe un comentario..."></textarea>
                        <div class="flex justify-end">
                            <button type="submit" class="px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold transition-colors shadow-lg shadow-blue-900/20">
                                Enviar comentario
                            </button>
                        </div>
                    </form>
                </div>

                <div class="border-t border-slate-800 pt-4">
                    <button onclick="document.getElementById('history-container').classList.toggle('hidden')" class="flex items-center gap-2 text-xs font-semibold text-slate-400 hover:text-white transition-colors mb-2 w-full">
                        <i class="ph ph-clock-counter-clockwise"></i> Ver historial de cambios
                        <i class="ph ph-caret-down ml-auto"></i>
                    </button>
                    <div id="history-container" class="hidden">
                        <div id="ticket-history" class="space-y-2 max-h-40 overflow-y-auto pr-1"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-6 flex justify-end gap-3 pt-4 border-t border-slate-800">
            <button type="button" id="ticket-edit-cancel" class="hidden px-5 py-2.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-sm font-medium transition-colors" onclick="cancelTicketEditMode()">
                Cancelar edición
            </button>
            <button type="button" id="ticket-edit-save" class="hidden px-5 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-sm font-semibold transition-colors shadow-lg shadow-blue-900/20" onclick="saveTicketEdits()">
                Guardar cambios
            </button>
            <button type="button" id="ticket-close-btn" class="px-5 py-2.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-sm font-medium transition-colors" onclick="closeTicketDetails()">
                Cerrar
            </button>
        </div>
    </div>
</div>
