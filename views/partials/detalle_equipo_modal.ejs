<div id="detalle-equipo-modal" class="fixed inset-0 bg-black/50 hidden flex items-center justify-center z-50">
    <div class="bg-slate-900 p-6 rounded-xl w-full max-w-xl shadow-2xl border border-slate-700 max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-xs uppercase tracking-wide text-slate-500">Detalle de equipo</h3>
            <button type="button" onclick="document.getElementById('detalle-equipo-modal').classList.add('hidden')" class="text-slate-400 hover:text-white">
                <i class="ph ph-x text-lg"></i>
            </button>
        </div>
        <div class="space-y-4 text-sm">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <p class="text-xs text-slate-500 mb-1">Marca / Modelo</p>
                    <p id="detalle-equipo-marca" class="text-slate-200"></p>
                </div>
                <div>
                    <p class="text-xs text-slate-500 mb-1">Número de serie</p>
                    <p id="detalle-equipo-serie" class="text-slate-200"></p>
                </div>
                <div>
                    <p class="text-xs text-slate-500 mb-1">Nº Orden</p>
                    <p id="detalle-equipo-orden" class="text-slate-200"></p>
                </div>
                <div>
                    <p class="text-xs text-slate-500 mb-1">Fecha de embarque</p>
                    <p id="detalle-equipo-embarque" class="text-slate-200"></p>
                </div>
                <div>
                    <p class="text-xs text-slate-500 mb-1">Fecha de ingreso</p>
                    <p id="detalle-equipo-ingreso" class="text-slate-200"></p>
                </div>
                <div>
                    <p class="text-xs text-slate-500 mb-1">Ubicación</p>
                    <p id="detalle-equipo-ubicacion" class="text-slate-200"></p>
                </div>
                <div>
                    <p class="text-xs text-slate-500 mb-1">Cliente</p>
                    <p id="detalle-equipo-cliente" class="text-slate-200"></p>
                </div>
                <div>
                    <p class="text-xs text-slate-500 mb-1">Aplicación</p>
                    <p id="detalle-equipo-aplicacion" class="text-slate-200"></p>
                </div>
                <div>
                    <p class="text-xs text-slate-500 mb-1">Año de venta</p>
                    <p id="detalle-equipo-anio" class="text-slate-200"></p>
                </div>
                <div>
                    <p class="text-xs text-slate-500 mb-1">Estado</p>
                    <span id="detalle-equipo-estado" class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium"></span>
                </div>
            </div>
            <div>
                <div class="flex items-center justify-between mb-2">
                    <p class="text-xs text-slate-500">Informes técnicos registrados</p>
                    <div id="detalle-equipo-add-mantencion"></div>
                </div>
                <div id="detalle-equipo-mantenciones" class="space-y-2 text-xs">
                </div>
            </div>
            <div class="mt-4">
                <p class="text-xs text-slate-500 mb-2">Tickets asociados</p>
                <div id="detalle-equipo-tickets" class="space-y-2 text-xs">
                </div>
            </div>
            <div class="text-xs text-slate-500 mt-2">
                <span id="detalle-equipo-creado"></span>
            </div>
        </div>
        <div class="mt-6 flex justify-end">
            <button type="button" onclick="document.getElementById('detalle-equipo-modal').classList.add('hidden')" class="px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-100 text-sm">
                Cerrar
            </button>
        </div>
    </div>
</div>
<script>
async function openDetalleEquipo(id) {
    try {
        const res = await fetch('/equipos/' + id, {
            headers: { Accept: 'application/json' }
        });
        if (!res.ok) {
            alert('Error al cargar el equipo');
            return;
        }
        const e = await res.json();

        const modalEl = document.getElementById('detalle-equipo-modal');
        const marcaEl = document.getElementById('detalle-equipo-marca');
        const serieEl = document.getElementById('detalle-equipo-serie');
        const ordenEl = document.getElementById('detalle-equipo-orden');
        const embarqueEl = document.getElementById('detalle-equipo-embarque');
        const ingresoEl = document.getElementById('detalle-equipo-ingreso');
        const ubicacionEl = document.getElementById('detalle-equipo-ubicacion');
        const clienteEl = document.getElementById('detalle-equipo-cliente');
        const aplicacionEl = document.getElementById('detalle-equipo-aplicacion');
        const anioEl = document.getElementById('detalle-equipo-anio');
        const estadoEl = document.getElementById('detalle-equipo-estado');
        const mantencionesEl = document.getElementById('detalle-equipo-mantenciones');
        const creadoEl = document.getElementById('detalle-equipo-creado');

        if (!modalEl || !marcaEl) return;

        marcaEl.textContent = [e.marca || '', e.modelo || ''].filter(Boolean).join(' - ') || '-';
        serieEl.textContent = e.numero_serie || '-';
        ordenEl.textContent = e.numero_orden || '-';
        embarqueEl.textContent = e.fecha_embarque ? new Date(e.fecha_embarque).toLocaleDateString('es-CL') : '-';
        if (ingresoEl) ingresoEl.textContent = e.fecha_ingreso ? new Date(e.fecha_ingreso).toLocaleDateString('es-CL') : '-';
        ubicacionEl.textContent = e.ubicacion || '-';
        clienteEl.textContent = e.cliente || 'Sin asignar';
        aplicacionEl.textContent = e.aplicacion || '-';
        anioEl.textContent = e.anio_venta || '-';

        const rawEstado = String(e.estado || '').toLowerCase();
        const enReparacion = rawEstado === 'en_reparacion' || rawEstado === 'reparacion';
        const estadoClass = enReparacion
            ? 'bg-amber-500/20 text-amber-200 border border-amber-400/60'
            : 'bg-emerald-600/20 text-emerald-300 border border-emerald-500/40';
        estadoEl.className = 'inline-flex items-center px-2 py-1 rounded-full text-xs font-medium ' + estadoClass;
        estadoEl.textContent = enReparacion ? 'Reparación' : 'Operativo';

        mantencionesEl.innerHTML = '';
        const list = Array.isArray(e.fichas_mantencion) && e.fichas_mantencion.length
            ? e.fichas_mantencion
            : (Array.isArray(e.mantenciones) ? e.mantenciones : []);
        if (list.length === 0) {
            mantencionesEl.innerHTML = '<p class="text-slate-500">No hay mantenciones registradas.</p>';
        } else {
            list.forEach(function (m) {
                const div = document.createElement('div');
                div.className = 'bg-slate-800/70 border border-slate-700 rounded-lg px-3 py-2';
                const fichaId = m.ficha_id || m.id;
                const fecha = m.fecha || '';
                const hora = m.hora || '';
                const trabajo = m.trabajo || '';
                const nota = m.nota || '';
                const realizado = m.realizado_por || '';
                const tipo = m.tipo || '';
                const estado = m.estado || '';
                const archivo = m.archivo || null;
                let fechaHoraTexto = '';
                if (fecha && hora) {
                    fechaHoraTexto = String(fecha).slice(0, 10) + ' ' + String(hora).slice(0, 5);
                } else if (fecha) {
                    fechaHoraTexto = String(fecha).slice(0, 10);
                } else if (hora) {
                    fechaHoraTexto = String(hora).slice(0, 5);
                }
                let badges = '';
                if (tipo) {
                    badges += '<span class="mr-1 px-1.5 py-0.5 rounded text-[10px] border ' +
                        (tipo === 'correctiva'
                            ? 'bg-amber-500/15 text-amber-300 border-amber-500/30'
                            : 'bg-teal-500/15 text-teal-300 border-teal-500/30') +
                        '">' + (tipo === 'correctiva' ? 'Correctiva' : 'Preventiva') + '</span>';
                }
                if (estado) {
                    badges += '<span class="px-1.5 py-0.5 rounded text-[10px] border ' +
                        (estado === 'firmada'
                            ? 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30'
                            : 'bg-slate-500/15 text-slate-300 border-slate-500/30') +
                        '">' + (estado === 'firmada' ? 'Firmada' : 'Borrador') + '</span>';
                }
                let archivoHtml = '';
                if (archivo && archivo.ruta) {
                    archivoHtml =
                        '<div class="mt-1">' +
                            '<a href="' + archivo.ruta + '" target="_blank" class="text-[10px] text-teal-300 hover:text-cyan-300 underline">Ver archivo</a>' +
                        '</div>';
                }
                const linkHtml = fichaId
                    ? '<a href="/mantenciones/' + fichaId + '" class="inline-flex items-center text-[10px] text-teal-300 hover:text-cyan-300 underline">' +
                        (estado === 'firmada' ? '<i class="ph ph-file-pdf mr-1"></i>Ver ficha PDF' : 'Continuar ficha') +
                      '</a>'
                    : '';
                div.innerHTML =
                    '<div class="flex justify-between items-start gap-2 mb-1">' +
                        '<div class="flex-1 min-w-0">' +
                            '<div class="mb-1">' + badges + '</div>' +
                            '<div class="text-[11px] font-medium text-slate-200 truncate">' + (trabajo || 'Mantención') + '</div>' +
                            (realizado ? '<div class="text-[10px] text-slate-400">Realizado por: ' + realizado + '</div>' : '') +
                        '</div>' +
                        '<div class="text-right flex-shrink-0">' +
                            (fechaHoraTexto ? '<div class="text-[10px] text-slate-400">' + fechaHoraTexto + '</div>' : '') +
                            '<div class="mt-1 space-y-1">' + linkHtml + archivoHtml + '</div>' +
                        '</div>' +
                    '</div>' +
                    (nota ? '<div class="text-[11px] text-slate-400 whitespace-pre-wrap mt-1">' + nota + '</div>' : '');
                mantencionesEl.appendChild(div);
            });
        }

        const addBtnWrap = document.getElementById('detalle-equipo-add-mantencion');
        if (addBtnWrap) {
            addBtnWrap.innerHTML =
                '<a href="/mantenciones/nueva?equipo_id=' + encodeURIComponent(e.id) + '" class="inline-flex items-center text-xs text-teal-300 hover:text-cyan-300 font-medium">' +
                    '<i class="ph ph-plus mr-1"></i> Nueva ficha' +
                '</a>';
        }

        const ticketsEl = document.getElementById('detalle-equipo-tickets');
        if (ticketsEl) {
            ticketsEl.innerHTML = '';
            const tickets = Array.isArray(e.tickets) ? e.tickets : [];
            if (tickets.length === 0) {
                ticketsEl.innerHTML = '<p class="text-slate-500">No hay tickets asociados.</p>';
            } else {
                tickets.forEach(function (t) {
                    const tDiv = document.createElement('div');
                    tDiv.className = 'bg-slate-800/70 border border-slate-700 rounded-lg px-3 py-2 flex justify-between items-center gap-2';

                    const estado = t.estado || 'pendiente';
                    let badgeClass = 'bg-slate-700 text-slate-300 border border-slate-600';
                    if (estado === 'pendiente' || estado === 'ingresado') badgeClass = 'bg-yellow-500/20 text-yellow-300 border border-yellow-500/30';
                    else if (estado === 'en_proceso' || estado === 'diagnostico' || estado === 'reparacion') badgeClass = 'bg-blue-500/20 text-blue-300 border border-blue-500/30';
                    else if (estado === 'hecho' || estado === 'terminado') badgeClass = 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';

                    const fechaCreacion = t.creado_en ? new Date(t.creado_en).toLocaleDateString('es-CL') : '';

                    tDiv.innerHTML =
                        '<div class="flex-1 min-w-0">' +
                            '<div class="flex items-center gap-2 mb-0.5">' +
                                '<span class="text-[10px] font-mono text-slate-500">#' + (t.codigo || t.id) + '</span>' +
                                '<span class="text-[11px] font-medium text-slate-200 truncate">' + (t.titulo || 'Sin título') + '</span>' +
                            '</div>' +
                            '<div class="text-[10px] text-slate-400 truncate">' + (t.descripcion || '') + '</div>' +
                        '</div>' +
                        '<div class="flex flex-col items-end gap-1">' +
                            '<span class="px-1.5 py-0.5 rounded text-[10px] border ' + badgeClass + '">' + estado + '</span>' +
                            '<span class="text-[10px] text-slate-500">' + fechaCreacion + '</span>' +
                        '</div>';
                    ticketsEl.appendChild(tDiv);
                });
            }
        }

        const creadoEn = e.creado_en ? new Date(e.creado_en) : null;
        const actualizadoEn = e.actualizado_en ? new Date(e.actualizado_en) : null;
        const partes = [];
        if (creadoEn) partes.push('Creado el ' + creadoEn.toLocaleString('es-CL'));
        if (actualizadoEn) partes.push('Actualizado el ' + actualizadoEn.toLocaleString('es-CL'));
        if (creadoEl) creadoEl.textContent = partes.join(' · ');

        modalEl.classList.remove('hidden');
    } catch (err) {
        console.error(err);
        alert('Error de conexión');
    }
}
</script>
