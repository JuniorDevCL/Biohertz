<div class="bh-shell bh-page">
    <div class="bh-head">
        <div class="min-w-0">
            <div class="flex items-center gap-3 flex-wrap">
                <h1 class="text-2xl font-bold text-white tracking-tight">Informes Técnicos</h1>
                <span class="bh-chip bg-slate-800 text-slate-200 border border-slate-700">
                    <i class="ph ph-clipboard-text text-sm"></i>
                    Fichas: <span class="font-semibold"><%= fichas && fichas.length ? fichas.length : 0 %></span>
                </span>
                <% if (typeof fotoStorage !== 'undefined' && fotoStorage) { %>
                <span class="bh-chip border <%= fotoStorage.warn ? 'bg-amber-500/10 text-amber-200 border-amber-500/30' : 'bg-slate-800 text-slate-200 border-slate-700' %>">
                    <i class="ph ph-hard-drives text-sm"></i>
                    Fotos: <%= fotoStorage.totalMb %> MB / <%= fotoStorage.quotaGb %> GB
                    <% if (fotoStorage.persistent) { %> · disco Render<% } %>
                </span>
                <% } %>
            </div>
            <p class="text-slate-400 text-sm mt-1">Informes técnicos de mantención preventiva y correctiva, con checklist y firmas en tablet.</p>
        </div>
        <div class="bh-head-actions">
            <a href="/mantenciones/nueva" class="bh-btn bg-blue-600 hover:bg-blue-700 text-white">
                <i class="ph ph-plus"></i> Nueva ficha
            </a>
        </div>
    </div>

    <div class="bh-panel bg-slate-900 border border-slate-800 shadow-xl">
        <form action="/mantenciones" method="GET" class="bh-toolbar border-b border-slate-800">
            <div class="bh-search">
                <i class="ph ph-magnifying-glass text-sm text-slate-500"></i>
                <input
                    type="text"
                    name="q"
                    value="<%= typeof query !== 'undefined' ? query : '' %>"
                    placeholder="Buscar por cliente, ficha, equipo, serie o técnico"
                    class="bh-ctl bg-slate-950 border border-slate-700 text-white placeholder-slate-500"
                >
            </div>
            <select name="tipo" class="bh-ctl bg-slate-950 border border-slate-700 text-white">
                <option value="">Todos los tipos</option>
                <option value="preventiva" <%= queryTipo === 'preventiva' ? 'selected' : '' %>>Preventiva</option>
                <option value="correctiva" <%= queryTipo === 'correctiva' ? 'selected' : '' %>>Correctiva</option>
            </select>
            <select name="estado" class="bh-ctl bg-slate-950 border border-slate-700 text-white">
                <option value="">Todos los estados</option>
                <option value="borrador" <%= queryEstado === 'borrador' ? 'selected' : '' %>>Borrador</option>
                <option value="firmada" <%= queryEstado === 'firmada' ? 'selected' : '' %>>Firmada</option>
            </select>
            <button type="submit" class="bh-btn bg-slate-800 hover:bg-slate-700 text-slate-100 border border-slate-700">
                <i class="ph ph-funnel-simple"></i>
                Filtrar
            </button>
        </form>

        <% if (fichas && fichas.length) { %>
            <div class="overflow-x-auto rounded-b-2xl min-w-0">
                <table class="bh-table text-left text-[13px]">
                    <thead>
                        <tr class="uppercase text-slate-400 font-semibold">
                            <th class="py-2.5 px-3 w-[96px]">Nº</th>
                            <th class="py-2.5 px-3 w-[104px]">Fecha</th>
                            <th class="py-2.5 px-3 w-[22%]">Cliente</th>
                            <th class="py-2.5 px-3">Equipo</th>
                            <th class="py-2.5 px-3 w-[112px]">Tipo</th>
                            <th class="py-2.5 px-3 w-[104px]">Estado</th>
                            <th class="py-2.5 px-3 w-[14%]">Técnico</th>
                            <th class="py-2.5 px-2 text-right bh-actions bh-actions-wide">Acción</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800/80">
                        <% fichas.forEach(f => {
                            const clienteLabel = f.cliente_nombre || f.senores || f.equipo_cliente || null;
                            const equipoLabel = [f.equipo_marca, f.equipo_modelo, f.equipo_serie].filter(Boolean).join(' · ');
                            const equipoMarcaModelo = [f.equipo_marca, f.equipo_modelo].filter(Boolean).join(' · ');
                        %>
                            <tr class="transition-colors group">
                                <td class="py-2 px-3 text-slate-200 font-mono text-xs">
                                    Nº <%= String(f.id).padStart(5, '0') %>
                                </td>
                                <td class="py-2 px-3 text-slate-300">
                                    <%= f.fecha ? new Date(f.fecha).toLocaleDateString('es-CL') : (f.creado_en ? new Date(f.creado_en).toLocaleDateString('es-CL') : '-') %>
                                    <% if (f.hora) { %>
                                        <div class="text-[11px] text-slate-500"><%= String(f.hora).slice(0,5) %></div>
                                    <% } %>
                                </td>
                                <td class="py-2 px-3 font-medium text-white" title="<%= clienteLabel || '' %>"><%= clienteLabel || '—' %></td>
                                <td class="py-2 px-3" title="<%= equipoLabel %>">
                                    <div class="text-slate-200 truncate"><%= equipoMarcaModelo || (f.equipo_serie ? '' : '—') %></div>
                                    <% if (f.equipo_serie) { %><div class="text-[11px] text-slate-500 truncate">S/N <%= f.equipo_serie %></div><% } %>
                                </td>
                                <td class="py-2 px-3">
                                    <% if (f.tipo === 'correctiva') { %>
                                        <span class="inline-flex px-2 py-0.5 rounded-full text-[11px] font-medium bg-amber-500/15 text-amber-300 border border-amber-500/30">Correctiva</span>
                                    <% } else { %>
                                        <span class="inline-flex px-2 py-0.5 rounded-full text-[11px] font-medium bg-teal-500/15 text-teal-300 border border-teal-500/30">Preventiva</span>
                                    <% } %>
                                </td>
                                <td class="py-2 px-3">
                                    <% if (f.estado === 'firmada') { %>
                                        <span class="inline-flex px-2 py-0.5 rounded-full text-[11px] font-medium bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">Firmada</span>
                                    <% } else { %>
                                        <span class="inline-flex px-2 py-0.5 rounded-full text-[11px] font-medium bg-slate-500/15 text-slate-300 border border-slate-500/30">Borrador</span>
                                    <% } %>
                                </td>
                                <td class="py-2 px-3 text-slate-300" title="<%= f.realizado_por || '' %>"><%= f.realizado_por || '-' %></td>
                                <td class="py-2 px-2 bh-actions bh-actions-wide">
                                    <div class="flex items-center justify-end gap-1">
                                        <a href="/mantenciones/<%= f.id %>" class="bh-btn bh-btn-sm bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-600">
                                            <i class="ph <%= f.estado === 'firmada' ? 'ph-file-pdf' : 'ph-pencil-simple' %>"></i>
                                            <%= f.estado === 'firmada' ? 'Ver ficha' : 'Continuar' %>
                                        </a>
                                        <details class="bh-menu">
                                            <summary class="bh-icon-btn hover:bg-slate-800 text-slate-400 hover:text-white" title="Más acciones"><i class="ph ph-dots-three-outline-vertical text-sm"></i></summary>
                                            <div class="bh-menu-list bg-slate-900 border border-slate-700">
                                                <a href="/mantenciones/<%= f.id %>" class="bh-menu-item text-slate-200 hover:bg-slate-800"><i class="ph <%= f.estado === 'firmada' ? 'ph-file-pdf' : 'ph-pencil-simple' %>"></i><%= f.estado === 'firmada' ? 'Ver ficha' : 'Continuar' %></a>
                                                <% if (f.estado === 'firmada') { %>
                                                    <a href="/mantenciones/<%= f.id %>/editar-textos" class="bh-menu-item text-slate-200 hover:bg-slate-800"><i class="ph ph-text-aa"></i>Editar textos</a>
                                                <% } %>
                                                <div class="bh-menu-sep bg-slate-700"></div>
                                                <button type="button" class="bh-menu-item text-red-300 hover:bg-red-500/10" onclick="eliminarFicha(<%= f.id %>)"><i class="ph ph-trash"></i>Eliminar ficha</button>
                                            </div>
                                        </details>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="text-center py-14 text-slate-400">
                <i class="ph ph-clipboard-text text-4xl text-slate-600 mb-3 block"></i>
                <p class="font-medium text-white mb-1">Aún no hay fichas</p>
                <p class="text-sm mb-4">Crea el primer informe técnico desde aquí o desde un equipo.</p>
                <a href="/mantenciones/nueva" class="inline-flex items-center text-teal-300 hover:text-cyan-300 text-sm font-medium">Nueva ficha →</a>
            </div>
        <% } %>
    </div>
</div>

<script>
async function eliminarFicha(id) {
    if (!id) return;
    const confirmed = confirm('¿Seguro que deseas eliminar esta ficha? Esta acción no se puede deshacer.');
    if (!confirmed) return;
    try {
        const res = await fetch('/mantenciones/' + id, {
            method: 'DELETE',
            headers: { Accept: 'application/json' }
        });
        if (!res.ok) {
            let msg = 'Error ' + res.status;
            try {
                const err = await res.json();
                if (err && err.error) msg = err.error;
            } catch (_) {}
            alert(msg);
            return;
        }
        window.location.reload();
    } catch (err) {
        console.error(err);
        alert('Error de conexión');
    }
}
</script>
