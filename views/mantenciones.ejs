<div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
        <div class="space-y-2">
            <div class="flex items-center gap-3 flex-wrap">
                <h1 class="text-3xl font-bold text-white tracking-tight">Mantenciones</h1>
                <span class="inline-flex items-center px-3 py-1.5 rounded-full bg-slate-800 text-xs text-slate-200 border border-slate-700">
                    <i class="ph ph-clipboard-text text-sm mr-1.5"></i>
                    Fichas: <span class="ml-1 font-semibold"><%= fichas && fichas.length ? fichas.length : 0 %></span>
                </span>
                <% if (typeof fotoStorage !== 'undefined' && fotoStorage) { %>
                <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs border <%= fotoStorage.warn ? 'bg-amber-500/10 text-amber-200 border-amber-500/30' : 'bg-slate-800 text-slate-200 border-slate-700' %>">
                    <i class="ph ph-hard-drives text-sm mr-1.5"></i>
                    Fotos: <%= fotoStorage.totalMb %> MB / <%= fotoStorage.quotaGb %> GB
                    <% if (fotoStorage.persistent) { %> · disco Render<% } %>
                </span>
                <% } %>
            </div>
            <p class="text-slate-400 text-sm">Fichas de mantención preventiva y correctiva, con checklist y firmas en tablet.</p>
        </div>
        <a href="/mantenciones/nueva" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2.5 rounded-xl transition-colors flex items-center justify-center text-sm font-medium shadow-sm">
            <i class="ph ph-plus mr-2 text-base"></i> Nueva ficha
        </a>
    </div>

    <div class="bg-slate-900 border border-slate-800 rounded-2xl shadow-xl p-4 sm:p-6">
        <form action="/mantenciones" method="GET" class="mb-4 flex flex-wrap items-center gap-3">
            <div class="flex-1 min-w-[180px]">
                <input
                    type="text"
                    name="q"
                    value="<%= typeof query !== 'undefined' ? query : '' %>"
                    placeholder="Buscar por equipo, serie o técnico"
                    class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-teal-400"
                >
            </div>
            <select name="tipo" class="bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white">
                <option value="">Todos los tipos</option>
                <option value="preventiva" <%= queryTipo === 'preventiva' ? 'selected' : '' %>>Preventiva</option>
                <option value="correctiva" <%= queryTipo === 'correctiva' ? 'selected' : '' %>>Correctiva</option>
            </select>
            <select name="estado" class="bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white">
                <option value="">Todos los estados</option>
                <option value="borrador" <%= queryEstado === 'borrador' ? 'selected' : '' %>>Borrador</option>
                <option value="firmada" <%= queryEstado === 'firmada' ? 'selected' : '' %>>Firmada</option>
            </select>
            <button type="submit" class="bg-slate-800 hover:bg-slate-700 text-slate-100 px-4 py-2 rounded-lg text-sm border border-slate-700">Filtrar</button>
        </form>

        <% if (fichas && fichas.length) { %>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse min-w-[720px]">
                    <thead>
                        <tr class="bg-slate-800/30 text-xs uppercase text-slate-400 font-semibold tracking-wider">
                            <th class="py-3 px-4">Fecha</th>
                            <th class="py-3 px-4">Equipo</th>
                            <th class="py-3 px-4">Tipo</th>
                            <th class="py-3 px-4">Estado</th>
                            <th class="py-3 px-4">Técnico</th>
                            <th class="py-3 px-4 text-right">Acción</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800">
                        <% fichas.forEach(f => { %>
                            <tr class="hover:bg-slate-800/40 transition-colors text-sm">
                                <td class="py-3 px-4 text-slate-300 whitespace-nowrap">
                                    <%= f.fecha ? new Date(f.fecha).toLocaleDateString('es-CL') : (f.creado_en ? new Date(f.creado_en).toLocaleDateString('es-CL') : '-') %>
                                    <% if (f.hora) { %>
                                        <div class="text-[11px] text-slate-500"><%= String(f.hora).slice(0,5) %></div>
                                    <% } %>
                                </td>
                                <td class="py-3 px-4">
                                    <div class="font-medium text-white"><%= f.equipo_nombre || 'Equipo' %></div>
                                    <div class="text-xs text-slate-500">
                                        <%= [f.equipo_marca, f.equipo_modelo].filter(Boolean).join(' · ') || '-' %>
                                        <% if (f.equipo_serie) { %> · <%= f.equipo_serie %><% } %>
                                    </div>
                                </td>
                                <td class="py-3 px-4">
                                    <% if (f.tipo === 'correctiva') { %>
                                        <span class="px-2 py-1 rounded-full text-xs font-medium bg-amber-500/15 text-amber-300 border border-amber-500/30">Correctiva</span>
                                    <% } else { %>
                                        <span class="px-2 py-1 rounded-full text-xs font-medium bg-teal-500/15 text-teal-300 border border-teal-500/30">Preventiva</span>
                                    <% } %>
                                </td>
                                <td class="py-3 px-4">
                                    <% if (f.estado === 'firmada') { %>
                                        <span class="px-2 py-1 rounded-full text-xs font-medium bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">Firmada</span>
                                    <% } else { %>
                                        <span class="px-2 py-1 rounded-full text-xs font-medium bg-slate-500/15 text-slate-300 border border-slate-500/30">Borrador</span>
                                    <% } %>
                                </td>
                                <td class="py-3 px-4 text-slate-300"><%= f.realizado_por || '-' %></td>
                                <td class="py-3 px-4 text-right">
                                    <div class="inline-flex items-center gap-2 flex-wrap justify-end">
                                        <a href="/mantenciones/<%= f.id %>" class="inline-flex items-center px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs border border-slate-600">
                                            <i class="ph <%= f.estado === 'firmada' ? 'ph-file-pdf' : 'ph-pencil-simple' %> mr-1.5"></i>
                                            <%= f.estado === 'firmada' ? 'Ver ficha' : 'Continuar' %>
                                        </a>
                                        <% if (f.estado === 'firmada') { %>
                                            <a href="/mantenciones/<%= f.id %>/editar-textos" class="inline-flex items-center px-3 py-1.5 rounded-lg bg-teal-600/20 hover:bg-teal-600/40 text-teal-200 text-xs border border-teal-500/40">
                                                <i class="ph ph-text-aa mr-1.5"></i>
                                                Editar textos
                                            </a>
                                        <% } %>
                                        <button
                                            type="button"
                                            onclick="eliminarFicha(<%= f.id %>)"
                                            class="inline-flex items-center px-3 py-1.5 rounded-lg bg-red-600/20 hover:bg-red-600/40 text-red-200 text-xs border border-red-500/40"
                                            title="Eliminar ficha"
                                        >
                                            <i class="ph ph-trash mr-1.5"></i>
                                            Eliminar
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="text-center py-14 text-slate-400">
                <i class="ph ph-clipboard-text text-4xl text-slate-600 mb-3 block"></i>
                <p class="font-medium text-white mb-1">Aún no hay fichas</p>
                <p class="text-sm mb-4">Crea la primera mantención desde aquí o desde un equipo.</p>
                <a href="/mantenciones/nueva" class="inline-flex items-center text-teal-300 hover:text-cyan-300 text-sm font-medium">Nueva ficha →</a>
            </div>
        <% } %>
    </div>
</div>

<script>
async function eliminarFicha(id) {
    if (!id) return;
    const confirmed = confirm('¿Seguro que deseas eliminar esta ficha? Esta acción no se puede deshacer.');
    if (!confirmed) return;
    try {
        const res = await fetch('/mantenciones/' + id, {
            method: 'DELETE',
            headers: { Accept: 'application/json' }
        });
        if (!res.ok) {
            let msg = 'Error ' + res.status;
            try {
                const err = await res.json();
                if (err && err.error) msg = err.error;
            } catch (_) {}
            alert(msg);
            return;
        }
        window.location.reload();
    } catch (err) {
        console.error(err);
        alert('Error de conexión');
    }
}
</script>
