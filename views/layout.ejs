<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'BIODATA' %></title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="icon" href="/img/biodata-logo.svg" type="image/svg+xml">

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <script src="/socket.io/socket.io.js"></script>
    <link rel="stylesheet" href="/theme.css">

    <style>
        body { background-color: #070b12; color: #e8eef8; font-family: "Plus Jakarta Sans", "Segoe UI", sans-serif; }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: rgba(30, 41, 59, 0.5); border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(71, 85, 105, 0.8); border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(100, 116, 139, 1); }
    </style>
</head>
<body class="h-screen flex overflow-hidden" style="background:#070b12">

    <!-- Sidebar -->
    <aside class="w-64 border-r flex flex-col transition-all duration-300" id="sidebar" style="background:rgba(11,18,32,.88);backdrop-filter:blur(18px);border-color:rgba(148,163,184,.13)">
        <div class="px-5 py-5 flex items-center gap-3">
            <img src="/img/biodata-logo.svg" alt="BIODATA" class="h-10 w-10 rounded-xl object-cover shrink-0">
            <div class="min-w-0">
                <div class="text-sm font-bold tracking-[0.16em] text-white">BIODATA</div>
                <div class="text-[11px] text-slate-400 truncate">Sistema de tickets</div>
            </div>
        </div>

        <nav class="flex-1 px-3 space-y-1 mt-2">
            <a href="/dashboard" class="sidebar-link">
                <i class="ph ph-squares-four"></i>
                <span>Dashboard</span>
            </a>
            <a href="/tickets" class="sidebar-link">
                <i class="ph ph-ticket"></i>
                <span>Tickets</span>
            </a>
            <a href="/clientes" class="sidebar-link">
                <i class="ph ph-users"></i>
                <span>Clientes</span>
            </a>
            <a href="/equipos" class="sidebar-link">
                <i class="ph ph-desktop"></i>
                <span>Equipos</span>
            </a>
            <a href="/calendario" class="sidebar-link">
                <i class="ph ph-calendar-blank"></i>
                <span>Calendario</span>
            </a>

            <% if (typeof user !== 'undefined' && user.email === 'alexis.cruces2122@gmail.com') { %>
            <div class="my-2 border-t mx-2" style="border-color:rgba(148,163,184,.12)"></div>
            <a href="/usuarios" class="sidebar-link">
                <i class="ph ph-user-gear"></i>
                <span>Usuarios</span>
            </a>
            <% } %>
        </nav>

        <div class="p-3">
            <div class="flex items-center gap-3 px-3 py-2.5 rounded-2xl" style="border:1px solid rgba(148,163,184,.13);background:rgba(255,255,255,.03)">
                <div class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold shrink-0" style="background:linear-gradient(135deg,#14b8a6,#38bdf8);color:#042f2e">
                    <%= typeof user !== 'undefined' ? user.nombre.charAt(0).toUpperCase() : 'U' %>
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-white truncate">
                        <%= typeof user !== 'undefined' ? user.nombre : 'Usuario' %>
                    </p>
                    <p class="text-xs text-slate-400 truncate">
                        <%= typeof user !== 'undefined' ? user.email : '' %>
                    </p>
                </div>
                <a href="/auth/logout" class="text-slate-400 hover:text-red-400 transition-colors" title="Cerrar Sesión">
                    <i class="ph ph-sign-out text-lg"></i>
                </a>
            </div>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col overflow-hidden">
        <!-- Header Mobile (Visible only on small screens) -->
        <header class="border-b p-4 flex items-center justify-between md:hidden" style="background:#0b1220;border-color:rgba(148,163,184,.13)">
            <div class="flex items-center gap-2">
                <img src="/img/biodata-logo.svg" alt="BIODATA" class="h-9 w-9 rounded-xl object-cover">
                <span class="text-sm font-bold tracking-[0.14em]">BIODATA</span>
            </div>
            <button class="text-white" onclick="document.getElementById('sidebar').classList.toggle('-translate-x-full')">
                <i class="ph ph-list text-2xl"></i>
            </button>
        </header>

        <main class="flex-1 overflow-auto p-6 relative page-enter">
            <!-- Flash Messages -->
            <% if (typeof success_msg !== 'undefined' && success_msg) { %>
                <div class="bg-emerald-500/10 border border-emerald-500/50 text-emerald-400 px-4 py-3 rounded-xl mb-4 flex items-center gap-2">
                    <i class="ph ph-check-circle text-lg"></i>
                    <%= success_msg %>
                </div>
            <% } %>
            <% if (typeof error_msg !== 'undefined' && error_msg) { %>
                <div class="bg-red-500/10 border border-red-500/50 text-red-400 px-4 py-3 rounded-xl mb-4 flex items-center gap-2">
                    <i class="ph ph-warning-circle text-lg"></i>
                    <%= error_msg %>
                </div>
            <% } %>

            <%- body %>
        </main>
    </div>

    <script>
        // Socket.IO Connection
        const socket = io();

        socket.on('connect', () => {
            console.log('Conectado al servidor de WebSocket');
        });

        socket.on('ticket:created', (ticket) => {
            console.log('Nuevo ticket recibido:', ticket);
            // Si estamos en el dashboard, recargar para ver los cambios
            if (window.location.pathname === '/dashboard') {
                window.location.reload();
            }
        });

        // Highlight active link
        const currentPath = window.location.pathname;
        document.querySelectorAll('.sidebar-link').forEach(link => {
            const href = link.getAttribute('href');
            if (href === currentPath || (href !== '/' && currentPath.startsWith(href))) {
                link.classList.add('active');
            }
        });
    </script>
</body>
</html>
