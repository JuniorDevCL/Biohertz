<%
  const fmtEqDate = (d) => d
    ? new Date(d).toLocaleDateString('es-CL', { day: '2-digit', month: '2-digit', year: '2-digit', timeZone: 'America/Santiago' })
    : '—';
%>
<style>
  .eq-page { min-width: 0; max-width: 100%; }
  .eq-table { table-layout: fixed; width: 100%; max-width: 100%; border-collapse: collapse; }
  .eq-table th, .eq-table td {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    vertical-align: middle;
  }
  .eq-table th.eq-actions, .eq-table td.eq-actions {
    position: sticky;
    right: 0;
    width: 124px;
    min-width: 124px;
    max-width: 124px;
    overflow: visible;
    white-space: nowrap;
    z-index: 4;
    box-shadow: -8px 0 10px -8px rgba(0,0,0,.55);
  }
  .eq-table thead th { background: #151e30; }
  .eq-table td.eq-actions { background: #101827; }
  .eq-table tbody tr:hover td { background: rgba(30, 41, 59, 0.45); }
  .eq-table tbody tr:hover td.eq-actions { background: #1a2436; }
  .eq-icon-btn {
    width: 26px;
    height: 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    border: 1px solid transparent;
    transition: background .15s ease, border-color .15s ease;
    flex-shrink: 0;
  }
  @media (max-width: 1535px) {
    .eq-col-extra { display: none !important; }
  }
</style>

<div class="eq-page mx-auto px-1 py-4">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 mb-4">
        <div class="space-y-1">
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-bold text-white tracking-tight">Equipos</h1>
                <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-slate-800 text-xs text-slate-200 border border-slate-700">
                    <i class="ph ph-desktop text-sm mr-1.5"></i>
                    Equipos totales: <span class="ml-1 font-semibold"><%= typeof totalEquipos !== 'undefined' ? totalEquipos : 0 %></span>
                </span>
            </div>
            <p class="text-slate-400 text-sm">Visualiza todos los equipos y su estado actual.</p>
        </div>
        <div class="flex flex-col sm:flex-row gap-2 w-full md:w-auto">
            <form action="/equipos" method="GET" class="flex-1 flex items-center gap-2">
                <div class="relative w-full">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-500">
                        <i class="ph ph-magnifying-glass text-sm"></i>
                    </span>
                    <input 
                        type="text" 
                        name="q" 
                        value="<%= typeof query !== 'undefined' ? query : '' %>" 
                        placeholder="Buscar por marca, modelo, serie o Nº orden" 
                        class="w-full bg-slate-900 border border-slate-700 rounded-lg pl-9 pr-3 py-2 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                    >
                </div>
                <button type="submit" class="hidden sm:inline-flex items-center px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-100 rounded-lg text-sm transition-colors">
                    Buscar
                </button>
            </form>
            <button onclick="document.getElementById('new-equipo-modal').classList.remove('hidden')" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-xl transition-colors flex items-center justify-center text-sm font-medium shadow-sm shadow-blue-500/30 whitespace-nowrap">
                <i class="ph ph-plus mr-2 text-base"></i> Nuevo Equipo
            </button>
        </div>
    </div>

    <div class="bg-slate-900 border border-slate-800 rounded-2xl shadow-xl">
        <% if (typeof equipos !== 'undefined' && equipos && equipos.length > 0) { %>
            <div class="overflow-x-auto rounded-2xl min-w-0">
                <table class="eq-table text-left text-[13px]">
                    <thead>
                        <tr class="text-[11px] uppercase text-slate-400 font-semibold tracking-wider">
                            <th class="py-2 px-3">Marca</th>
                            <th class="py-2 px-3">Modelo</th>
                            <th class="py-2 px-3">Serie</th>
                            <th class="py-2 px-3 eq-col-extra">Nº Orden</th>
                            <th class="py-2 px-3 eq-col-extra">F. embarque</th>
                            <th class="py-2 px-3 eq-col-extra">F. ingreso</th>
                            <th class="py-2 px-3">Cliente</th>
                            <th class="py-2 px-3">Ubicación</th>
                            <th class="py-2 px-3 eq-col-extra">F. Inst.</th>
                            <th class="py-2 px-3">Estado</th>
                            <th class="py-2 px-2 text-right eq-actions">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800/80">
                        <% equipos.forEach(equipo => { %>
                            <tr class="transition-colors group">
                                <td class="py-1.5 px-3 font-medium text-white" title="<%= equipo.marca || '' %>"><%= equipo.marca || '—' %></td>
                                <td class="py-1.5 px-3 text-slate-300" title="<%= equipo.modelo || '' %>"><%= equipo.modelo || '—' %></td>
                                <td class="py-1.5 px-3 text-slate-400" title="<%= equipo.numero_serie || '' %>"><%= equipo.numero_serie || '—' %></td>
                                <td class="py-1.5 px-3 text-slate-400 eq-col-extra" title="<%= equipo.numero_orden || '' %>"><%= equipo.numero_orden || '—' %></td>
                                <td class="py-1.5 px-3 text-slate-400 eq-col-extra"><%= fmtEqDate(equipo.fecha_embarque) %></td>
                                <td class="py-1.5 px-3 text-slate-400 eq-col-extra"><%= fmtEqDate(equipo.fecha_ingreso) %></td>
                                <td class="py-1.5 px-3 text-slate-300" title="<%= equipo.cliente || '' %>">
                                    <% if (equipo.cliente) { %>
                                        <span class="inline-flex items-center gap-1 min-w-0 max-w-full">
                                            <i class="ph ph-user text-slate-500 shrink-0"></i>
                                            <span class="truncate"><%= equipo.cliente %></span>
                                        </span>
                                    <% } else { %>
                                        <span class="text-slate-500">Sin asignar</span>
                                    <% } %>
                                </td>
                                <td class="py-1.5 px-3 text-slate-400" title="<%= equipo.ubicacion || '' %>"><%= equipo.ubicacion || '—' %></td>
                                <td class="py-1.5 px-3 text-slate-400 eq-col-extra"><%= fmtEqDate(equipo.fecha_instalacion) %></td>
                                <td class="py-1.5 px-3">
                                    <% 
                                        const rawEstado = String(equipo.estado || '').toLowerCase();
                                        const enReparacion = rawEstado === 'en_reparacion' || rawEstado === 'reparacion';
                                        const estadoClass = enReparacion
                                            ? 'bg-amber-500/20 text-amber-300 border-amber-400/50'
                                            : 'bg-emerald-600/20 text-emerald-400 border-emerald-500/40';
                                    %>
                                    <span class="inline-flex px-1.5 py-0.5 rounded-full text-[11px] font-medium border <%= estadoClass %>">
                                        <%= enReparacion ? 'Reparación' : 'Operativo' %>
                                    </span>
                                </td>
                                <td class="py-1.5 px-2 eq-actions">
                                    <div class="flex items-center justify-end gap-1">
                                        <button type="button" onclick="openEditEquipo('<%= equipo.id %>')" class="eq-icon-btn bg-yellow-600/20 hover:bg-yellow-500/30 text-yellow-200 border-yellow-500/40" title="Editar equipo">
                                            <i class="ph ph-pencil-simple text-sm"></i>
                                        </button>
                                        <% if (typeof user !== 'undefined' && user && user.rol === 'admin') { %>
                                            <button type="button" onclick="deleteEquipo('<%= equipo.id %>')" class="eq-icon-btn bg-red-600/20 hover:bg-red-600/40 text-red-200 border-red-500/40" title="Eliminar equipo">
                                                <i class="ph ph-trash text-sm"></i>
                                            </button>
                                        <% } %>
                                        <button 
                                            type="button" 
                                            data-equipo-id="<%= equipo.id %>" 
                                            data-equipo-nombre="<%- equipo.nombre || '' %>" 
                                            onclick="openMantencionDesdeBoton(this)" 
                                            class="eq-icon-btn bg-emerald-600/20 hover:bg-emerald-500/30 text-emerald-200 border-emerald-500/40" 
                                            title="Ver informes técnicos">
                                            <i class="ph ph-file-pdf text-sm"></i>
                                        </button>
                                        <button type="button" onclick="openDetalleEquipo('<%= equipo.id %>')" class="eq-icon-btn bg-slate-800 hover:bg-slate-700 text-slate-200 border-slate-600/60" title="Ver detalle">
                                            <i class="ph ph-eye text-sm"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="text-center py-12">
                <div class="text-slate-500 mb-4 text-5xl"><i class="ph ph-desktop"></i></div>
                <p class="text-slate-400 text-lg">No hay equipos registrados.</p>
                <p class="text-slate-500 text-sm">Registra un nuevo equipo para comenzar.</p>
            </div>
        <% } %>
    </div>
</div>

<!-- Modal Nuevo Equipo -->
<div id="new-equipo-modal" class="fixed inset-0 bg-black/50 hidden flex items-center justify-center z-50">
    <div class="bg-slate-800 p-6 rounded-xl w-full max-w-lg shadow-2xl border border-slate-700 overflow-y-auto max-h-[90vh]">
        <h3 class="text-xl font-bold text-white mb-4">Nuevo Equipo</h3>
        <form action="/equipos" method="POST">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-slate-400 text-sm mb-2">Marca</label>
                    <input type="text" name="marca" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-slate-400 text-sm mb-2">Modelo</label>
                    <input type="text" name="modelo" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-slate-400 text-sm mb-2">Serie</label>
                    <input type="text" name="numero_serie" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-slate-400 text-sm mb-2">Nº Orden</label>
                    <input type="text" name="numero_orden" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-slate-400 text-sm mb-2">Fecha de embarque</label>
                    <input type="date" name="fecha_embarque" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-slate-400 text-sm mb-2">Fecha de ingreso</label>
                    <input type="date" name="fecha_ingreso" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500">
                </div>
            </div>
            <div class="flex justify-end gap-3 mt-6">
                <button type="button" onclick="document.getElementById('new-equipo-modal').classList.add('hidden')" class="px-4 py-2 text-slate-300 hover:text-white">Cancelar</button>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded">Guardar</button>
            </div>
        </form>
    </div>
</div>

<div id="edit-equipo-modal" class="fixed inset-0 bg-black/50 hidden flex items-center justify-center z-50">
    <div class="bg-slate-800 p-6 rounded-xl w-full max-w-lg shadow-2xl border border-slate-700 overflow-y-auto max-h-[90vh]">
        <h3 class="text-xl font-bold text-white mb-4">Editar Equipo</h3>
        <form onsubmit="submitEditEquipo(event)">
            <input type="hidden" id="edit-equipo-id" name="id">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-slate-400 text-sm mb-2">Nombre</label>
                    <input type="text" id="edit-equipo-nombre" name="nombre" required class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-slate-400 text-sm mb-2">Marca</label>
                    <input type="text" id="edit-equipo-marca" name="marca" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-slate-400 text-sm mb-2">Modelo</label>
                    <input type="text" id="edit-equipo-modelo" name="modelo" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-slate-400 text-sm mb-2">N° Serie</label>
                    <input type="text" id="edit-equipo-numero_serie" name="numero_serie" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-slate-400 text-sm mb-2">Nº Orden</label>
                    <input type="text" id="edit-equipo-numero_orden" name="numero_orden" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-slate-400 text-sm mb-2">Fecha de embarque</label>
                    <input type="date" id="edit-equipo-fecha_embarque" name="fecha_embarque" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-slate-400 text-sm mb-2">Fecha de ingreso</label>
                    <input type="date" id="edit-equipo-fecha_ingreso" name="fecha_ingreso" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-slate-400 text-sm mb-2">Ubicación</label>
                    <input type="text" id="edit-equipo-ubicacion" name="ubicacion" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-slate-400 text-sm mb-2">Cliente (Opcional)</label>
                    <select id="edit-equipo-cliente" name="cliente_id" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500">
                        <option value="">Seleccionar Cliente</option>
                        <% if (typeof clientes !== 'undefined') { %>
                            <% clientes.forEach(c => { %>
                                <option value="<%= c.id %>"><%= c.nombre %></option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                <div>
                    <label class="block text-slate-400 text-sm mb-2">Estado</label>
                    <select id="edit-equipo-estado" name="estado" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500">
                        <option value="operativo">Operativo</option>
                        <option value="en_reparacion">Reparación</option>
                    </select>
                </div>
                <div>
                    <label class="block text-slate-400 text-sm mb-2">Fecha de Instalación</label>
                    <input type="date" id="edit-equipo-fecha_instalacion" name="fecha_instalacion" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-slate-400 text-sm mb-2">Plazo garantía (meses)</label>
                    <input type="number" min="1" max="120" id="edit-equipo-plazo_garantia_meses" name="plazo_garantia_meses" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500">
                    <p id="edit-equipo-vcto_msg" class="text-[11px] mt-1 text-emerald-400"></p>
                </div>
                <div class="md:col-span-2">
                    <label class="block text-slate-400 text-sm mb-2">Cant. MP Garantía</label>
                    <input type="number" min="0" max="24" id="edit-equipo-cant_mp_garantia" name="cant_mp_garantia" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500">
                    <p class="text-[10px] text-slate-500 mt-1">Las fechas se muestran en el calendario con color distinto (MP Garantía).</p>
                    <div id="edit-equipo-mp_fechas_wrap" class="grid grid-cols-1 md:grid-cols-2 gap-2 mt-2"></div>
                </div>
            </div>
            <div class="flex justify-end gap-3 mt-6">
                <button type="button" onclick="document.getElementById('edit-equipo-modal').classList.add('hidden')" class="px-4 py-2 text-slate-300 hover:text-white">Cancelar</button>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded">Guardar cambios</button>
            </div>
        </form>
    </div>
</div>

<div id="mantencion-modal" class="fixed inset-0 bg-black/50 hidden flex items-center justify-center z-50">
    <div class="bg-slate-900 p-6 rounded-xl w-full max-w-md shadow-2xl border border-slate-700 max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between mb-4">
            <div>
                <p class="text-xs uppercase tracking-wide text-slate-500">Registrar mantención</p>
                <h3 id="mantencion-equipo-nombre" class="text-xl font-bold text-white mt-1"></h3>
            </div>
            <button type="button" onclick="closeMantencionModal()" class="text-slate-400 hover:text-white">
                <i class="ph ph-x text-lg"></i>
            </button>
        </div>
        <form id="mantencion-form" onsubmit="submitMantencion(event)" enctype="multipart/form-data" class="space-y-4 text-sm">
            <input type="hidden" id="mantencion-equipo-id" name="equipo_id">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-slate-400 text-xs mb-1">Fecha</label>
                    <input type="date" name="fecha" required class="w-full bg-slate-950 border border-slate-700 rounded px-2 py-1.5 text-xs text-white focus:outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-slate-400 text-xs mb-1">Hora</label>
                    <input type="time" name="hora" required class="w-full bg-slate-950 border border-slate-700 rounded px-2 py-1.5 text-xs text-white focus:outline-none focus:border-blue-500">
                </div>
            </div>
            <div>
                <label class="block text-slate-400 text-xs mb-1">Realizado por</label>
                <input type="text" name="realizado_por" placeholder="Nombre de quien realiza la mantención" class="w-full bg-slate-950 border border-slate-700 rounded px-2 py-1.5 text-xs text-white focus:outline-none focus:border-blue-500">
            </div>
            <div>
                <label class="block text-slate-400 text-xs mb-1">Trabajo realizado</label>
                <textarea name="trabajo" rows="2" class="w-full bg-slate-950 border border-slate-700 rounded px-2 py-1.5 text-xs text-white focus:outline-none focus:border-blue-500"></textarea>
            </div>
            <div>
                <label class="block text-slate-400 text-xs mb-1">Notas adicionales</label>
                <textarea name="nota" rows="2" class="w-full bg-slate-950 border border-slate-700 rounded px-2 py-1.5 text-xs text-white focus:outline-none focus:border-blue-500"></textarea>
            </div>
            <div>
                <label class="block text-slate-400 text-xs mb-1">Archivo de respaldo (PNG o PDF)</label>
                <input type="file" name="archivo" accept=".png,.pdf" class="w-full text-xs text-slate-300">
            </div>
            <div class="flex justify-end gap-3 pt-2">
                <button type="button" onclick="closeMantencionModal()" class="px-4 py-2 text-slate-300 hover:text-white text-xs">
                    Cancelar
                </button>
                <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded text-xs font-medium">
                    Guardar mantención
                </button>
            </div>
        </form>
    </div>
</div>

<div id="detalle-equipo-modal" class="fixed inset-0 bg-black/50 hidden flex items-center justify-center z-50">
    <div class="bg-slate-900 p-6 rounded-xl w-full max-w-xl shadow-2xl border border-slate-700 max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between mb-4">
            <div>
                <p class="text-xs uppercase tracking-wide text-slate-500">Detalle de equipo</p>
                <h3 id="detalle-equipo-nombre" class="text-xl font-bold text-white mt-1"></h3>
            </div>
            <button type="button" onclick="document.getElementById('detalle-equipo-modal').classList.add('hidden')" class="text-slate-400 hover:text-white">
                <i class="ph ph-x text-lg"></i>
            </button>
        </div>
        <div class="space-y-4 text-sm">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <p class="text-xs text-slate-500 mb-1">Marca / Modelo</p>
                    <p id="detalle-equipo-marca" class="text-slate-200"></p>
                </div>
                <div>
                    <p class="text-xs text-slate-500 mb-1">Número de serie</p>
                    <p id="detalle-equipo-serie" class="text-slate-200"></p>
                </div>
                <div>
                    <p class="text-xs text-slate-500 mb-1">Nº Orden</p>
                    <p id="detalle-equipo-orden" class="text-slate-200"></p>
                </div>
                <div>
                    <p class="text-xs text-slate-500 mb-1">Fecha de embarque</p>
                    <p id="detalle-equipo-embarque" class="text-slate-200"></p>
                </div>
                <div>
                    <p class="text-xs text-slate-500 mb-1">Fecha de ingreso</p>
                    <p id="detalle-equipo-ingreso" class="text-slate-200"></p>
                </div>
                <div>
                    <p class="text-xs text-slate-500 mb-1">Ubicación</p>
                    <p id="detalle-equipo-ubicacion" class="text-slate-200"></p>
                </div>
                <div>
                    <p class="text-xs text-slate-500 mb-1">Cliente</p>
                    <p id="detalle-equipo-cliente" class="text-slate-200"></p>
                </div>
                <div>
                    <p class="text-xs text-slate-500 mb-1">Aplicación</p>
                    <p id="detalle-equipo-aplicacion" class="text-slate-200"></p>
                </div>
                <div>
                    <p class="text-xs text-slate-500 mb-1">Año de venta</p>
                    <p id="detalle-equipo-anio" class="text-slate-200"></p>
                </div>
                <div>
                    <p class="text-xs text-slate-500 mb-1">Estado</p>
                    <span id="detalle-equipo-estado" class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium"></span>
                </div>
            </div>
            <div>
                <div class="flex items-center justify-between mb-2">
                    <p class="text-xs text-slate-500">Informes técnicos registrados</p>
                    <div id="detalle-equipo-add-mantencion"></div>
                </div>
                <div id="detalle-equipo-mantenciones" class="space-y-2 text-xs">
                </div>
            </div>
            <div class="mt-4">
                <p class="text-xs text-slate-500 mb-2">Tickets asociados</p>
                <div id="detalle-equipo-tickets" class="space-y-2 text-xs">
                </div>
            </div>
            <div class="text-xs text-slate-500 mt-2">
                <span id="detalle-equipo-creado"></span>
            </div>
        </div>
        <div class="mt-6 flex justify-end">
            <button type="button" onclick="document.getElementById('detalle-equipo-modal').classList.add('hidden')" class="px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-100 text-sm">
                Cerrar
            </button>
        </div>
    </div>
</div>

<script>
function openMantencionDesdeBoton(btn) {
    if (!btn) return;
    const id = btn.dataset.equipoId || '';
    openFichaODetalle(id);
}

async function openFichaODetalle(id) {
    if (!id) return;
    try {
        const res = await fetch(`/equipos/${id}`, {
            headers: { Accept: 'application/json' }
        });
        if (!res.ok) {
            openDetalleEquipo(id);
            return;
        }
        const e = await res.json();
        const list = Array.isArray(e.fichas_mantencion) && e.fichas_mantencion.length
            ? e.fichas_mantencion
            : (Array.isArray(e.mantenciones) ? e.mantenciones : []);
        const firmada = list.find((m) => m.estado === 'firmada');
        const fichaId = firmada ? (firmada.ficha_id || firmada.id) : null;
        if (fichaId) {
            window.location.href = '/mantenciones/' + encodeURIComponent(fichaId);
            return;
        }
        // Sin ficha firmada: abrir detalle para ver borradores o crear nueva
        openDetalleEquipo(id);
    } catch (err) {
        console.error(err);
        openDetalleEquipo(id);
    }
}

function openMantencionModal(id) {
    if (!id) return;
    openFichaODetalle(id);
}

function closeMantencionModal() {
    const modal = document.getElementById('mantencion-modal');
    if (modal) modal.classList.add('hidden');
}

async function submitMantencion(ev) {
    ev.preventDefault();
    const form = ev.target;
    const idInput = document.getElementById('mantencion-equipo-id');
    const id = idInput ? idInput.value : '';
    if (!id) {
        alert('ID de equipo no válido');
        return;
    }
    const formData = new FormData(form);
    try {
        const res = await fetch(`/equipos/${id}/mantenciones`, {
            method: 'POST',
            headers: {
                'Accept': 'application/json'
            },
            body: formData
        });
        if (res.ok) {
            closeMantencionModal();
            window.location.reload();
        } else {
            let msg = 'Error ' + res.status;
            try {
                const err = await res.json();
                if (err && err.error) msg += ': ' + err.error;
            } catch (_) {}
            alert(msg);
        }
    } catch (err) {
        console.error(err);
        alert('Error de conexión');
    }
}

async function openDetalleEquipo(id) {
    try {
        const res = await fetch(`/equipos/${id}`, {
            headers: {
                'Accept': 'application/json'
            }
        });
        if (!res.ok) {
            alert('Error al cargar el equipo');
            return;
        }
        const e = await res.json();

        const nombreEl = document.getElementById('detalle-equipo-nombre');
        const marcaEl = document.getElementById('detalle-equipo-marca');
        const serieEl = document.getElementById('detalle-equipo-serie');
        const ordenEl = document.getElementById('detalle-equipo-orden');
        const embarqueEl = document.getElementById('detalle-equipo-embarque');
        const ingresoEl = document.getElementById('detalle-equipo-ingreso');
        const ubicacionEl = document.getElementById('detalle-equipo-ubicacion');
        const clienteEl = document.getElementById('detalle-equipo-cliente');
        const aplicacionEl = document.getElementById('detalle-equipo-aplicacion');
        const anioEl = document.getElementById('detalle-equipo-anio');
        const estadoEl = document.getElementById('detalle-equipo-estado');
        const mantencionesEl = document.getElementById('detalle-equipo-mantenciones');
        const creadoEl = document.getElementById('detalle-equipo-creado');

        if (!nombreEl) return;

        nombreEl.textContent = e.nombre || '';
        marcaEl.textContent = [e.marca || '', e.modelo || ''].filter(Boolean).join(' - ') || '-';
        serieEl.textContent = e.numero_serie || '-';
        ordenEl.textContent = e.numero_orden || '-';
        embarqueEl.textContent = e.fecha_embarque ? new Date(e.fecha_embarque).toLocaleDateString('es-CL') : '-';
        if (ingresoEl) ingresoEl.textContent = e.fecha_ingreso ? new Date(e.fecha_ingreso).toLocaleDateString('es-CL') : '-';
        ubicacionEl.textContent = e.ubicacion || '-';
        clienteEl.textContent = e.cliente || 'Sin asignar';
        aplicacionEl.textContent = e.aplicacion || '-';
        anioEl.textContent = e.anio_venta || '-';

        const rawEstado = String(e.estado || '').toLowerCase();
        const enReparacion = rawEstado === 'en_reparacion' || rawEstado === 'reparacion';
        const estadoClass = enReparacion
            ? 'bg-amber-500/20 text-amber-200 border border-amber-400/60'
            : 'bg-emerald-600/20 text-emerald-300 border border-emerald-500/40';
        estadoEl.className = 'inline-flex items-center px-2 py-1 rounded-full text-xs font-medium ' + estadoClass;
        estadoEl.textContent = enReparacion ? 'Reparación' : 'Operativo';

        mantencionesEl.innerHTML = '';
        const list = Array.isArray(e.fichas_mantencion) && e.fichas_mantencion.length
            ? e.fichas_mantencion
            : (Array.isArray(e.mantenciones) ? e.mantenciones : []);
        if (list.length === 0) {
            mantencionesEl.innerHTML = '<p class="text-slate-500">No hay mantenciones registradas.</p>';
        } else {
            list.forEach(m => {
                const div = document.createElement('div');
                div.className = 'bg-slate-800/70 border border-slate-700 rounded-lg px-3 py-2';
                const fichaId = m.ficha_id || m.id;
                const fecha = m.fecha || '';
                const hora = m.hora || '';
                const trabajo = m.trabajo || '';
                const nota = m.nota || '';
                const realizado = m.realizado_por || '';
                const tipo = m.tipo || '';
                const estado = m.estado || '';
                const archivo = m.archivo || null;
                let fechaHoraTexto = '';
                if (fecha && hora) {
                    fechaHoraTexto = String(fecha).slice(0, 10) + ' ' + String(hora).slice(0, 5);
                } else if (fecha) {
                    fechaHoraTexto = String(fecha).slice(0, 10);
                } else if (hora) {
                    fechaHoraTexto = String(hora).slice(0, 5);
                }
                let badges = '';
                if (tipo) {
                    badges += '<span class="mr-1 px-1.5 py-0.5 rounded text-[10px] border ' +
                        (tipo === 'correctiva'
                            ? 'bg-amber-500/15 text-amber-300 border-amber-500/30'
                            : 'bg-teal-500/15 text-teal-300 border-teal-500/30') +
                        '">' + (tipo === 'correctiva' ? 'Correctiva' : 'Preventiva') + '</span>';
                }
                if (estado) {
                    badges += '<span class="px-1.5 py-0.5 rounded text-[10px] border ' +
                        (estado === 'firmada'
                            ? 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30'
                            : 'bg-slate-500/15 text-slate-300 border-slate-500/30') +
                        '">' + (estado === 'firmada' ? 'Firmada' : 'Borrador') + '</span>';
                }
                let archivoHtml = '';
                if (archivo && archivo.ruta) {
                    archivoHtml =
                        '<div class="mt-1">' +
                            '<a href="' + archivo.ruta + '" target="_blank" class="text-[10px] text-teal-300 hover:text-cyan-300 underline">Ver archivo</a>' +
                        '</div>';
                }
                const linkHtml = fichaId
                    ? '<a href="/mantenciones/' + fichaId + '" class="inline-flex items-center text-[10px] text-teal-300 hover:text-cyan-300 underline">' +
                        (estado === 'firmada' ? '<i class="ph ph-file-pdf mr-1"></i>Ver ficha PDF' : 'Continuar ficha') +
                      '</a>'
                    : '';
                div.innerHTML =
                    '<div class="flex justify-between items-start gap-2 mb-1">' +
                        '<div class="flex-1 min-w-0">' +
                            '<div class="mb-1">' + badges + '</div>' +
                            '<div class="text-[11px] font-medium text-slate-200 truncate">' + (trabajo || 'Mantención') + '</div>' +
                            (realizado ? '<div class="text-[10px] text-slate-400">Realizado por: ' + realizado + '</div>' : '') +
                        '</div>' +
                        '<div class="text-right flex-shrink-0">' +
                            (fechaHoraTexto ? '<div class="text-[10px] text-slate-400">' + fechaHoraTexto + '</div>' : '') +
                            '<div class="mt-1 space-y-1">' + linkHtml + archivoHtml + '</div>' +
                        '</div>' +
                    '</div>' +
                    (nota ? '<div class="text-[11px] text-slate-400 whitespace-pre-wrap mt-1">' + nota + '</div>' : '');
                mantencionesEl.appendChild(div);
            });
        }

        const addBtnWrap = document.getElementById('detalle-equipo-add-mantencion');
        if (addBtnWrap) {
            addBtnWrap.innerHTML =
                '<a href="/mantenciones/nueva?equipo_id=' + encodeURIComponent(e.id) + '" class="inline-flex items-center text-xs text-teal-300 hover:text-cyan-300 font-medium">' +
                    '<i class="ph ph-plus mr-1"></i> Nueva ficha' +
                '</a>';
        }

        const ticketsEl = document.getElementById('detalle-equipo-tickets');
        if (ticketsEl) {
            ticketsEl.innerHTML = '';
            const tickets = Array.isArray(e.tickets) ? e.tickets : [];
            if (tickets.length === 0) {
                ticketsEl.innerHTML = '<p class="text-slate-500">No hay tickets asociados.</p>';
            } else {
                tickets.forEach(t => {
                    const tDiv = document.createElement('div');
                    tDiv.className = 'bg-slate-800/70 border border-slate-700 rounded-lg px-3 py-2 flex justify-between items-center gap-2';
                    
                    const estado = t.estado || 'pendiente';
                    let badgeClass = 'bg-slate-700 text-slate-300 border border-slate-600';
                    if (estado === 'pendiente' || estado === 'ingresado') badgeClass = 'bg-yellow-500/20 text-yellow-300 border border-yellow-500/30';
                    else if (estado === 'en_proceso' || estado === 'diagnostico' || estado === 'reparacion') badgeClass = 'bg-blue-500/20 text-blue-300 border border-blue-500/30';
                    else if (estado === 'hecho' || estado === 'terminado') badgeClass = 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
                    
                    const fechaCreacion = t.creado_en ? new Date(t.creado_en).toLocaleDateString('es-CL') : '';
                    
                    tDiv.innerHTML = 
                        '<div class="flex-1 min-w-0">' +
                            '<div class="flex items-center gap-2 mb-0.5">' +
                                '<span class="text-[10px] font-mono text-slate-500">#' + (t.codigo || t.id) + '</span>' +
                                '<span class="text-[11px] font-medium text-slate-200 truncate">' + (t.titulo || 'Sin título') + '</span>' +
                            '</div>' +
                            '<div class="text-[10px] text-slate-400 truncate">' + (t.descripcion || '') + '</div>' +
                        '</div>' +
                        '<div class="flex flex-col items-end gap-1">' +
                            '<span class="px-1.5 py-0.5 rounded text-[10px] border ' + badgeClass + '">' + estado + '</span>' +
                            '<span class="text-[10px] text-slate-500">' + fechaCreacion + '</span>' +
                        '</div>';
                    ticketsEl.appendChild(tDiv);
                });
            }
        }

        const creadoEn = e.creado_en ? new Date(e.creado_en) : null;
        const actualizadoEn = e.actualizado_en ? new Date(e.actualizado_en) : null;
        const partes = [];
        if (creadoEn) partes.push('Creado el ' + creadoEn.toLocaleString('es-CL'));
        if (actualizadoEn) partes.push('Actualizado el ' + actualizadoEn.toLocaleString('es-CL'));
        creadoEl.textContent = partes.join(' · ');

        document.getElementById('detalle-equipo-modal').classList.remove('hidden');
    } catch (err) {
        console.error(err);
        alert('Error de conexión');
    }
}

async function openEditEquipo(id) {
    try {
        const res = await fetch(`/equipos/${id}`);
        if (!res.ok) {
            alert('Error al cargar el equipo');
            return;
        }
        const e = await res.json();
        document.getElementById('edit-equipo-id').value = e.id || '';
        document.getElementById('edit-equipo-nombre').value = e.nombre || '';
        document.getElementById('edit-equipo-marca').value = e.marca || '';
        document.getElementById('edit-equipo-modelo').value = e.modelo || '';
        document.getElementById('edit-equipo-numero_serie').value = e.numero_serie || '';
        const ordenInput = document.getElementById('edit-equipo-numero_orden');
        if (ordenInput) {
            ordenInput.value = e.numero_orden || '';
        }
        const fechaEmbarqueInput = document.getElementById('edit-equipo-fecha_embarque');
        if (fechaEmbarqueInput) {
            fechaEmbarqueInput.value = e.fecha_embarque ? String(e.fecha_embarque).split('T')[0] : '';
        }
        const fechaIngresoInput = document.getElementById('edit-equipo-fecha_ingreso');
        if (fechaIngresoInput) {
            fechaIngresoInput.value = e.fecha_ingreso ? String(e.fecha_ingreso).split('T')[0] : '';
        }
        document.getElementById('edit-equipo-ubicacion').value = e.ubicacion || '';
        const rawEditEstado = String(e.estado || '').toLowerCase();
        document.getElementById('edit-equipo-estado').value = (rawEditEstado === 'en_reparacion' || rawEditEstado === 'reparacion') ? 'en_reparacion' : 'operativo';
        const clienteSelect = document.getElementById('edit-equipo-cliente');
        if (clienteSelect) {
            clienteSelect.value = e.cliente_id || '';
        }
        const fechaInstInput = document.getElementById('edit-equipo-fecha_instalacion');
        if (fechaInstInput) {
            fechaInstInput.value = e.fecha_instalacion ? String(e.fecha_instalacion).split('T')[0] : '';
        }
        const plazoInput = document.getElementById('edit-equipo-plazo_garantia_meses');
        if (plazoInput) plazoInput.value = e.plazo_garantia_meses || '';
        const fechas = Array.isArray(e.mp_garantia_fechas) ? e.mp_garantia_fechas.map(function (f) { return String(f).slice(0, 10); }) : [];
        const cantInput = document.getElementById('edit-equipo-cant_mp_garantia');
        const wrap = document.getElementById('edit-equipo-mp_fechas_wrap');
        if (cantInput) cantInput.value = fechas.length ? String(fechas.length) : '';
        if (wrap && typeof renderMpFechaInputs === 'function') {
            wrap.dataset.fechas = fechas.join(',');
            renderMpFechaInputs(wrap, fechas.length, fechas);
        }
        const vcto = document.getElementById('edit-equipo-vcto_msg');
        if (vcto && typeof addMonthsYmd === 'function') {
            const ymd = e.fecha_vencimiento_garantia
                ? String(e.fecha_vencimiento_garantia).slice(0, 10)
                : addMonthsYmd(e.fecha_instalacion, e.plazo_garantia_meses);
            vcto.textContent = ymd && typeof formatYmdEs === 'function' ? ('Vencimiento: ' + formatYmdEs(ymd)) : (ymd ? ('Vencimiento: ' + ymd) : '');
        }
        document.getElementById('edit-equipo-modal').classList.remove('hidden');
    } catch (err) {
        console.error(err);
        alert('Error de conexión');
    }
}

async function submitEditEquipo(ev) {
    ev.preventDefault();
    const id = document.getElementById('edit-equipo-id').value;
    if (!id) {
        alert('ID de equipo no válido');
        return;
    }
    const formData = new FormData(ev.target);
    const data = Object.fromEntries(formData.entries());
    const wrap = document.getElementById('edit-equipo-mp_fechas_wrap');
    data.mp_fechas = typeof collectMpFechas === 'function' ? collectMpFechas(wrap) : [];
    try {
        const res = await fetch(`/equipos/${id}`, {
            method: 'PATCH',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify(data)
        });
        if (res.ok) {
            window.location.reload();
        } else {
            let msg = 'Error ' + res.status;
            try {
                const err = await res.json();
                if (err && err.error) msg += ': ' + err.error;
            } catch (_) {}
            alert(msg);
        }
    } catch (err) {
        console.error(err);
        alert('Error de conexión');
    }
}

async function deleteEquipo(id) {
    const confirmed = confirm('¿Seguro que deseas eliminar este equipo? Esta acción no se puede deshacer.');
    if (!confirmed) return;
    try {
        const res = await fetch(`/equipos/${id}`, {
            method: 'DELETE',
            headers: { 'Accept': 'application/json' }
        });
        if (res.ok) {
            window.location.reload();
        } else {
            let msg = 'Error ' + res.status;
            try {
                const err = await res.json();
                if (err && err.error) msg += ': ' + err.error;
            } catch (_) {}
            alert(msg);
        }
    } catch (err) {
        console.error(err);
        alert('Error de conexión');
    }
}
</script>
