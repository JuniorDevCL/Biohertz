<%
  const f = typeof ficha !== 'undefined' && ficha ? ficha : null;
  const isReadonly = !!readonly;
  const today = new Date().toISOString().slice(0, 10);
  const nowTime = new Date().toTimeString().slice(0, 5);
  const initialTipo = f ? f.tipo : 'preventiva';
  const checklistJson = JSON.stringify(checklist || []);
  const pre = typeof clientePrefill !== 'undefined' && clientePrefill ? clientePrefill : {};
  const cats = typeof categoriasAtencion !== 'undefined' && categoriasAtencion ? categoriasAtencion : [];
  const selectedCats = f && Array.isArray(f.categorias) ? f.categorias.map(String) : [];
  const fotosIniciales = f && Array.isArray(f.fotos) ? f.fotos : [];
%>
<style>
  .sig-pad {
    touch-action: none;
    background: #ffffff;
    border: 1px dashed rgba(100,116,139,.55);
    border-radius: 12px;
    width: 100%;
    height: 160px;
    cursor: crosshair;
  }
  .sig-pad.locked { opacity: .85; cursor: default; }
  .check-item { transition: background .15s ease, border-color .15s ease; }
  .check-item:has(input:checked) {
    border-color: rgba(232,119,26,.55);
    background: rgba(232,119,26,.08);
  }
  .foto-thumb { width: 100%; height: 88px; object-fit: cover; border-radius: 10px; border: 1px solid #334155; }
</style>

<div class="max-w-3xl mx-auto px-4 sm:px-6 py-5 sm:py-8">
  <div class="mb-6 flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
    <div>
      <a href="/mantenciones" class="text-slate-400 hover:text-white text-sm inline-flex items-center mb-3">
        <i class="ph ph-arrow-left mr-1.5"></i> Volver a Mantenciones
      </a>
      <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
        <%= f ? (isReadonly ? 'Ficha firmada' : 'Continuar ficha') : 'Nueva ficha de mantención' %>
      </h1>
      <p class="text-slate-400 text-sm mt-1">Ficha tipo Atención a clientes Biohertz: checklist, fotos y firmas en tablet.</p>
    </div>
    <% if (f && f.estado === 'firmada') { %>
      <span class="inline-flex self-start px-3 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">Firmada · bloqueada</span>
    <% } %>
  </div>

  <form id="ficha-form" class="space-y-5">
    <% if (f) { %><input type="hidden" id="ficha-id" value="<%= f.id %>"><% } %>

    <section class="bg-slate-900 border border-slate-800 rounded-2xl p-4 sm:p-5 space-y-4">
      <h2 class="text-sm font-semibold text-white uppercase tracking-wider">Equipo y tipo</h2>
      <div class="space-y-2">
        <label class="block text-xs text-slate-400 mb-1 uppercase">Equipo</label>
        <% if (isReadonly || f) { %>
          <input type="hidden" name="equipo_id" id="equipo_id" value="<%= f ? f.equipo_id : (equipo ? equipo.id : '') %>">
          <div class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-3 text-sm text-white">
            <% const eqLocked = equipo || (f && { nombre: f.equipo_nombre, marca: f.equipo_marca, modelo: f.equipo_modelo, numero_serie: f.equipo_serie }); %>
            <%= eqLocked ? ([eqLocked.nombre, [eqLocked.marca, eqLocked.modelo].filter(Boolean).join(' '), eqLocked.numero_serie ? 'Serie: ' + eqLocked.numero_serie : ''].filter(Boolean).join(' · ')) : 'Equipo' %>
          </div>
        <% } else { %>
          <input type="hidden" name="equipo_id" id="equipo_id" value="<%= equipo ? equipo.id : '' %>" required>
          <div class="relative">
            <div class="flex gap-2">
              <div class="relative flex-1">
                <i class="ph ph-barcode absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 text-lg pointer-events-none"></i>
                <input
                  type="search"
                  id="equipo-serie-search"
                  autocomplete="off"
                  placeholder="Buscar por número de serie, nombre o marca…"
                  value="<%= equipo && equipo.numero_serie ? equipo.numero_serie : '' %>"
                  class="w-full bg-slate-950 border border-slate-700 rounded-xl pl-10 pr-3 py-3 text-sm text-white focus:outline-none focus:border-teal-400"
                >
              </div>
            </div>
            <div id="equipo-search-results" class="hidden absolute z-20 mt-1 w-full max-h-56 overflow-y-auto rounded-xl border border-slate-700 bg-slate-950 shadow-xl"></div>
          </div>
          <div id="equipo-selected" class="<%= equipo ? '' : 'hidden' %> rounded-xl border border-teal-500/30 bg-teal-500/10 px-3 py-2.5 text-sm">
            <div class="flex items-start justify-between gap-2">
              <div>
                <p id="equipo-selected-nombre" class="text-white font-medium"><%= equipo ? (equipo.nombre || '') : '' %></p>
                <p id="equipo-selected-meta" class="text-xs text-slate-400 mt-0.5">
                  <% if (equipo) { %>
                    <%= [equipo.marca, equipo.modelo].filter(Boolean).join(' ') || 's/marca' %><%= equipo.numero_serie ? ' · Serie: ' + equipo.numero_serie : '' %>
                  <% } %>
                </p>
              </div>
              <button type="button" id="equipo-clear" class="text-xs text-slate-400 hover:text-white shrink-0">Cambiar</button>
            </div>
          </div>
          <p id="equipo-search-hint" class="text-[11px] text-slate-500">Escribe el N° de serie para encontrar el equipo rápido en terreno.</p>
        <% } %>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <label class="flex items-center gap-2 p-3 rounded-xl border border-slate-700 bg-slate-950/50 cursor-pointer">
          <input type="radio" name="tipo" value="preventiva" class="accent-teal-400" <%= initialTipo !== 'correctiva' ? 'checked' : '' %> <%= isReadonly ? 'disabled' : '' %>>
          <span class="text-sm text-white">Preventiva</span>
        </label>
        <label class="flex items-center gap-2 p-3 rounded-xl border border-slate-700 bg-slate-950/50 cursor-pointer">
          <input type="radio" name="tipo" value="correctiva" class="accent-amber-400" <%= initialTipo === 'correctiva' ? 'checked' : '' %> <%= isReadonly ? 'disabled' : '' %>>
          <span class="text-sm text-white">Correctiva</span>
        </label>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs text-slate-400 mb-1 uppercase">Fecha</label>
          <input type="date" name="fecha" value="<%= f && f.fecha ? String(f.fecha).slice(0,10) : today %>" <%= isReadonly ? 'disabled' : '' %>
            class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-3 text-sm text-white">
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1 uppercase">Hora</label>
          <input type="time" name="hora" value="<%= f && f.hora ? String(f.hora).slice(0,5) : nowTime %>" <%= isReadonly ? 'disabled' : '' %>
            class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-3 text-sm text-white">
        </div>
      </div>

      <div>
        <p class="text-[11px] text-slate-500 uppercase tracking-wider mb-2">Tipo de atención</p>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
          <% cats.forEach(function(c) { %>
            <label class="flex items-center gap-2 p-2.5 rounded-xl border border-slate-700 bg-slate-950/50 cursor-pointer text-xs text-slate-200">
              <input type="checkbox" name="categoria" value="<%= c.id %>" class="accent-orange-500"
                <%= selectedCats.includes(c.id) ? 'checked' : '' %> <%= isReadonly ? 'disabled' : '' %>>
              <%= c.label %>
            </label>
          <% }) %>
        </div>
      </div>
    </section>

    <section class="bg-slate-900 border border-slate-800 rounded-2xl p-4 sm:p-5 space-y-3">
      <h2 class="text-sm font-semibold text-white uppercase tracking-wider">Datos del cliente</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-xs text-slate-400 mb-1 uppercase">RUT</label>
          <input type="text" name="rut_cliente" <%= isReadonly ? 'disabled' : '' %>
            value="<%= f ? (f.rut_cliente || '') : '' %>"
            class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-3 text-sm text-white">
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1 uppercase">Señor(es)</label>
          <input type="text" name="senores" <%= isReadonly ? 'disabled' : '' %>
            value="<%= f ? (f.senores || '') : (pre.senores || '') %>"
            class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-3 text-sm text-white">
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1 uppercase">Dirección</label>
          <input type="text" name="direccion" <%= isReadonly ? 'disabled' : '' %>
            value="<%= f ? (f.direccion || '') : (pre.direccion || '') %>"
            class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-3 text-sm text-white">
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1 uppercase">Ciudad - Comuna</label>
          <input type="text" name="ciudad_comuna" <%= isReadonly ? 'disabled' : '' %>
            value="<%= f ? (f.ciudad_comuna || '') : '' %>"
            class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-3 text-sm text-white">
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1 uppercase">Teléfono</label>
          <input type="text" name="telefono_cliente" <%= isReadonly ? 'disabled' : '' %>
            value="<%= f ? (f.telefono_cliente || '') : (pre.telefono_cliente || '') %>"
            class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-3 text-sm text-white">
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1 uppercase">Contacto</label>
          <input type="text" name="contacto_nombre" <%= isReadonly ? 'disabled' : '' %>
            value="<%= f ? (f.contacto_nombre || '') : '' %>"
            class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-3 text-sm text-white">
        </div>
        <div class="sm:col-span-2">
          <label class="block text-xs text-slate-400 mb-1 uppercase">Versión S/W</label>
          <input type="text" name="version_sw" <%= isReadonly ? 'disabled' : '' %>
            value="<%= f ? (f.version_sw || '') : '' %>"
            class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-3 text-sm text-white">
        </div>
      </div>
    </section>

    <section id="section-checklist" class="bg-slate-900 border border-slate-800 rounded-2xl p-4 sm:p-5 space-y-3 <%= initialTipo === 'correctiva' ? 'hidden' : '' %>">
      <div class="flex items-center justify-between gap-2">
        <h2 class="text-sm font-semibold text-white uppercase tracking-wider">Checklist preventiva</h2>
        <span id="checklist-marca" class="text-[11px] text-teal-300/80"></span>
      </div>
      <p class="text-xs text-slate-500">19 ítems de protocolo preventiva. Márcalos al completarlos.</p>
      <div id="checklist-list" class="space-y-2"></div>
    </section>

    <section id="section-dano" class="bg-slate-900 border border-slate-800 rounded-2xl p-4 sm:p-5 space-y-3 <%= initialTipo === 'correctiva' ? '' : 'hidden' %>">
      <h2 class="text-sm font-semibold text-white uppercase tracking-wider">Daño / motivo (correctiva)</h2>
      <textarea name="dano_descripcion" rows="3" <%= isReadonly ? 'disabled' : '' %>
        placeholder="Describe el daño o falla atendida"
        class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-3 text-sm text-white"><%= f ? (f.dano_descripcion || '') : '' %></textarea>
    </section>

    <section class="bg-slate-900 border border-slate-800 rounded-2xl p-4 sm:p-5 space-y-3">
      <h2 class="text-sm font-semibold text-white uppercase tracking-wider">Motivo y descripción</h2>
      <div>
        <label class="block text-xs text-slate-400 mb-1 uppercase">Motivo de atención</label>
        <input type="text" name="motivo_atencion" <%= isReadonly ? 'disabled' : '' %>
          value="<%= f ? (f.motivo_atencion || '') : '' %>"
          placeholder="Ej: Reparación y mantención de equipo"
          class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-3 text-sm text-white">
      </div>
      <textarea name="trabajo" rows="4" <%= isReadonly ? 'disabled' : '' %>
        placeholder="Descripción de los trabajos realizados"
        class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-3 text-sm text-white"><%= f ? (f.trabajo || '') : '' %></textarea>
      <textarea name="nota" rows="2" <%= isReadonly ? 'disabled' : '' %>
        placeholder="Observaciones adicionales (opcional)"
        class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-3 text-sm text-white"><%= f ? (f.nota || '') : '' %></textarea>
      <div>
        <label class="block text-xs text-slate-400 mb-1 uppercase">Realizado por (servicio técnico)</label>
        <input type="text" name="realizado_por" <%= isReadonly ? 'disabled' : '' %>
          value="<%= f ? (f.realizado_por || '') : (user && user.nombre ? user.nombre : '') %>"
          class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-3 text-sm text-white">
      </div>
    </section>

    <section class="bg-slate-900 border border-slate-800 rounded-2xl p-4 sm:p-5 space-y-3">
      <h2 class="text-sm font-semibold text-white uppercase tracking-wider">Registro fotográfico</h2>
      <p class="text-xs text-slate-500">Hasta 4 fotos (~150 KB c/u). Se comprimen en la tablet y se guardan en el disco persistente de Render.</p>
      <% if (!isReadonly) { %>
        <input type="file" id="fotos-input" accept="image/*" multiple capture="environment"
          class="block w-full text-xs text-slate-400 file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-slate-800 file:text-slate-200">
      <% } %>
      <div id="fotos-preview" class="grid grid-cols-3 gap-2"></div>
    </section>

    <section class="bg-slate-900 border border-slate-800 rounded-2xl p-4 sm:p-5 space-y-3">
      <h2 class="text-sm font-semibold text-white uppercase tracking-wider">Portal cliente</h2>
      <p class="text-xs text-slate-500">Al firmar, se crea una clave cifrada y se envía por correo al cliente (solo la primera vez o si aún no tenía acceso).</p>
      <div>
        <label class="block text-xs text-slate-400 mb-1 uppercase">Correo electrónico del cliente</label>
        <input type="email" name="email_cliente" <%= isReadonly ? 'disabled' : '' %>
          value="<%= f ? (f.email_cliente || '') : (typeof emailClientePrefill !== 'undefined' && emailClientePrefill ? emailClientePrefill : (pre.email_cliente || '')) %>"
          placeholder="cliente@empresa.cl"
          class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-3 text-sm text-white">
      </div>
      <div>
        <label class="block text-xs text-slate-400 mb-1 uppercase">Próxima mantención</label>
        <input type="date" name="proxima_mantencion" <%= isReadonly ? 'disabled' : '' %>
          value="<%= f && f.proxima_mantencion ? String(f.proxima_mantencion).slice(0,10) : '' %>"
          class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-3 text-sm text-white">
      </div>
    </section>

    <section class="bg-slate-900 border border-slate-800 rounded-2xl p-4 sm:p-5 space-y-4">
      <h2 class="text-sm font-semibold text-white uppercase tracking-wider">Firmas</h2>
      <p class="text-xs text-slate-500">Firma con el dedo o el lápiz de la tablet. Al firmar ambas, la ficha queda bloqueada.</p>

      <div>
        <div class="flex items-center justify-between mb-2">
          <label class="text-xs text-slate-400 uppercase">Firma del técnico</label>
          <% if (!isReadonly) { %>
            <button type="button" class="text-xs text-slate-400 hover:text-white" data-clear="sig-tecnico">Limpiar</button>
          <% } %>
        </div>
        <canvas id="sig-tecnico" class="sig-pad <%= isReadonly ? 'locked' : '' %>"></canvas>
      </div>

      <div>
        <label class="block text-xs text-slate-400 mb-1 uppercase">Nombre del cliente que firma</label>
        <input type="text" name="firmante_cliente" <%= isReadonly ? 'disabled' : '' %>
          value="<%= f ? (f.firmante_cliente || '') : '' %>"
          placeholder="Nombre y apellido"
          class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-3 text-sm text-white mb-3">
        <div class="flex items-center justify-between mb-2">
          <label class="text-xs text-slate-400 uppercase">Firma del cliente</label>
          <% if (!isReadonly) { %>
            <button type="button" class="text-xs text-slate-400 hover:text-white" data-clear="sig-cliente">Limpiar</button>
          <% } %>
        </div>
        <canvas id="sig-cliente" class="sig-pad <%= isReadonly ? 'locked' : '' %>"></canvas>
      </div>
    </section>

    <% if (!isReadonly) { %>
      <div class="sticky bottom-0 -mx-4 sm:mx-0 px-4 sm:px-0 py-3 bg-gradient-to-t from-[#070b12] via-[#070b12] to-transparent">
        <div class="flex flex-col sm:flex-row gap-2">
          <button type="button" id="btn-borrador" class="flex-1 px-4 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-white text-sm font-medium">
            Guardar borrador
          </button>
          <button type="button" id="btn-firmar" class="flex-1 px-4 py-3 rounded-xl text-sm font-semibold" style="background:linear-gradient(180deg,#2dd4bf,#14b8a6);color:#042f2e">
            Firmar y cerrar ficha
          </button>
        </div>
      </div>
    <% } else if (f && f.equipo_id) { %>
      <a href="/equipos" class="inline-flex text-sm text-teal-300 hover:text-cyan-300">Ver equipos →</a>
    <% } %>
  </form>
</div>

<script>
(() => {
  const readonly = <%= isReadonly ? 'true' : 'false' %>;
  let checklist = <%= checklistJson %>;
  const existingFirmaTecnico = <%- f && f.firma_tecnico ? JSON.stringify(f.firma_tecnico) : 'null' %>;
  const existingFirmaCliente = <%- f && f.firma_cliente ? JSON.stringify(f.firma_cliente) : 'null' %>;
  let fotos = <%- JSON.stringify(fotosIniciales.map(p => ({
    nombre: p.nombre || 'foto',
    archivo: p.archivo || null,
    url: p.url || null,
    data: p.data || null
  }))) %>;

  const listEl = document.getElementById('checklist-list');
  const marcaEl = document.getElementById('checklist-marca');
  const equipoIdInput = document.getElementById('equipo_id');
  const sectionChecklist = document.getElementById('section-checklist');
  const sectionDano = document.getElementById('section-dano');
  const equiposData = <%- JSON.stringify((equipos || []).map(eq => ({
    id: eq.id,
    nombre: eq.nombre || '',
    marca: eq.marca || '',
    modelo: eq.modelo || '',
    numero_serie: eq.numero_serie || '',
    cliente: eq.cliente || eq.cliente_nombre || '',
    senores: eq.cliente_nombre || eq.cliente || '',
    direccion: eq.cliente_direccion || eq.ubicacion || '',
    telefono: eq.cliente_telefono || '',
    email: eq.cliente_email || ''
  }))) %>;
  let selectedEquipoMarca = <%- JSON.stringify(equipo && equipo.marca ? equipo.marca : (f && f.equipo_marca ? f.equipo_marca : '')) %>;

  function currentTipo() {
    const el = document.querySelector('input[name="tipo"]:checked');
    return el ? el.value : 'preventiva';
  }

  function toggleTipoUI() {
    const preventiva = currentTipo() === 'preventiva';
    sectionChecklist.classList.toggle('hidden', !preventiva);
    sectionDano.classList.toggle('hidden', preventiva);
  }

  function renderChecklist() {
    listEl.innerHTML = '';
    if (!checklist.length) {
      listEl.innerHTML = '<p class="text-xs text-slate-500">Sin ítems de protocolo para esta marca.</p>';
      return;
    }
    checklist.forEach((item, idx) => {
      const row = document.createElement('label');
      row.className = 'check-item flex items-start gap-3 p-3 rounded-xl border border-slate-700 bg-slate-950/40 cursor-pointer';
      row.innerHTML =
        '<input type="checkbox" class="mt-1 accent-teal-400 scale-125" data-idx="' + idx + '" ' +
          (item.checked ? 'checked' : '') + ' ' + (readonly ? 'disabled' : '') + '>' +
        '<span class="text-[11px] text-slate-500 w-5 shrink-0">' + (idx + 1) + '.</span>' +
        '<span class="text-sm text-slate-200 leading-snug">' + (item.label || '') + '</span>';
      if (!readonly) {
        row.querySelector('input').addEventListener('change', (e) => {
          checklist[idx].checked = e.target.checked;
        });
      }
      listEl.appendChild(row);
    });
  }

  async function loadProtocoloForMarca(marca) {
    selectedEquipoMarca = marca || '';
    marcaEl.textContent = marca ? ('Marca: ' + marca) : 'Marca: genérico';
    try {
      const res = await fetch('/mantenciones/protocolo?marca=' + encodeURIComponent(marca || 'generico'), {
        headers: { Accept: 'application/json' }
      });
      if (!res.ok) return;
      const data = await res.json();
      checklist = (data.items || []).map((it) => ({ id: it.id, label: it.label, checked: false }));
      renderChecklist();
    } catch (e) {
      console.error(e);
    }
  }

  function normalize(s) {
    return String(s || '').toLowerCase().trim();
  }

  function selectEquipo(eq) {
    if (!equipoIdInput || !eq) return;
    equipoIdInput.value = eq.id;
    selectedEquipoMarca = eq.marca || '';
    const selectedBox = document.getElementById('equipo-selected');
    const nombreEl = document.getElementById('equipo-selected-nombre');
    const metaEl = document.getElementById('equipo-selected-meta');
    const searchEl = document.getElementById('equipo-serie-search');
    const resultsEl = document.getElementById('equipo-search-results');
    if (nombreEl) nombreEl.textContent = eq.nombre || 'Equipo';
    if (metaEl) {
      metaEl.textContent =
        ([eq.marca, eq.modelo].filter(Boolean).join(' ') || 's/marca') +
        (eq.numero_serie ? ' · Serie: ' + eq.numero_serie : '');
    }
    if (selectedBox) selectedBox.classList.remove('hidden');
    if (searchEl) searchEl.value = eq.numero_serie || eq.nombre || '';
    if (resultsEl) {
      resultsEl.classList.add('hidden');
      resultsEl.innerHTML = '';
    }
    if (currentTipo() === 'preventiva') loadProtocoloForMarca(eq.marca || '');
    const setIf = (name, value) => {
      const el = document.querySelector('[name="' + name + '"]');
      if (el && !el.value && value) el.value = value;
    };
    setIf('senores', eq.senores || eq.cliente);
    setIf('direccion', eq.direccion);
    setIf('telefono_cliente', eq.telefono);
    setIf('email_cliente', eq.email);
  }

  function clearEquipo() {
    if (equipoIdInput) equipoIdInput.value = '';
    selectedEquipoMarca = '';
    const selectedBox = document.getElementById('equipo-selected');
    const searchEl = document.getElementById('equipo-serie-search');
    const resultsEl = document.getElementById('equipo-search-results');
    if (selectedBox) selectedBox.classList.add('hidden');
    if (searchEl) {
      searchEl.value = '';
      searchEl.focus();
    }
    if (resultsEl) {
      resultsEl.classList.add('hidden');
      resultsEl.innerHTML = '';
    }
  }

  function renderEquipoResults(query) {
    const resultsEl = document.getElementById('equipo-search-results');
    if (!resultsEl) return;
    const q = normalize(query);
    if (!q) {
      resultsEl.classList.add('hidden');
      resultsEl.innerHTML = '';
      return;
    }
    const matches = equiposData.filter((eq) => {
      const serie = normalize(eq.numero_serie);
      const nombre = normalize(eq.nombre);
      const marca = normalize(eq.marca);
      const modelo = normalize(eq.modelo);
      return serie.includes(q) || nombre.includes(q) || marca.includes(q) || modelo.includes(q);
    }).slice(0, 12);

    if (!matches.length) {
      resultsEl.innerHTML = '<p class="px-3 py-3 text-xs text-slate-500">Sin equipos con ese criterio.</p>';
      resultsEl.classList.remove('hidden');
      return;
    }

    resultsEl.innerHTML = matches.map((eq) => {
      const meta = ([eq.marca, eq.modelo].filter(Boolean).join(' ') || 's/marca') +
        (eq.numero_serie ? ' · Serie: ' + eq.numero_serie : ' · Sin serie');
      return (
        '<button type="button" class="equipo-result w-full text-left px-3 py-2.5 hover:bg-slate-800/80 border-b border-slate-800 last:border-0" data-id="' + eq.id + '">' +
          '<div class="text-sm text-white font-medium">' + (eq.nombre || 'Equipo') + '</div>' +
          '<div class="text-[11px] text-slate-400 mt-0.5">' + meta + '</div>' +
        '</button>'
      );
    }).join('');
    resultsEl.classList.remove('hidden');
    resultsEl.querySelectorAll('.equipo-result').forEach((btn) => {
      btn.addEventListener('click', () => {
        const eq = equiposData.find((e) => String(e.id) === String(btn.dataset.id));
        if (eq) selectEquipo(eq);
      });
    });
  }

  const searchInput = document.getElementById('equipo-serie-search');
  if (searchInput && !readonly) {
    let debounce;
    searchInput.addEventListener('input', () => {
      clearTimeout(debounce);
      debounce = setTimeout(() => renderEquipoResults(searchInput.value), 120);
    });
    searchInput.addEventListener('focus', () => {
      if (searchInput.value.trim()) renderEquipoResults(searchInput.value);
    });
    document.addEventListener('click', (ev) => {
      const wrap = searchInput.closest('.relative');
      const resultsEl = document.getElementById('equipo-search-results');
      if (resultsEl && wrap && !wrap.contains(ev.target)) {
        resultsEl.classList.add('hidden');
      }
    });
  }
  const clearBtn = document.getElementById('equipo-clear');
  if (clearBtn) clearBtn.addEventListener('click', clearEquipo);

  document.querySelectorAll('input[name="tipo"]').forEach((r) => {
    r.addEventListener('change', () => {
      toggleTipoUI();
      if (currentTipo() === 'preventiva' && equipoIdInput && equipoIdInput.value) {
        loadProtocoloForMarca(selectedEquipoMarca);
      }
    });
  });

  function normalizeSignatureDataUrl(dataUrl, done) {
    if (!dataUrl) { done(null); return; }
    const img = new Image();
    img.onload = () => {
      const w = img.naturalWidth || 300;
      const h = img.naturalHeight || 160;
      const c = document.createElement('canvas');
      c.width = w;
      c.height = h;
      const ctx = c.getContext('2d');
      ctx.drawImage(img, 0, 0);
      const sample = ctx.getImageData(0, 0, Math.min(w, 80), Math.min(h, 80)).data;
      let dark = 0;
      for (let i = 0; i < sample.length; i += 4) {
        if (sample[i] < 72 && sample[i + 1] < 72 && sample[i + 2] < 72) dark++;
      }
      const needsInvert = dark > sample.length / 20;
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, w, h);
      if (needsInvert) ctx.filter = 'invert(1)';
      ctx.drawImage(img, 0, 0);
      ctx.filter = 'none';
      done(c.toDataURL('image/png'));
    };
    img.onerror = () => done(dataUrl);
    img.src = dataUrl;
  }

  function paintWhitePad(ctx, w, h) {
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, w, h);
  }

  function exportSignatureCanvas(canvas) {
    const out = document.createElement('canvas');
    out.width = canvas.width;
    out.height = canvas.height;
    const octx = out.getContext('2d');
    paintWhitePad(octx, out.width, out.height);
    octx.drawImage(canvas, 0, 0);
    return out.toDataURL('image/png');
  }

  function setupPad(canvasId, existingDataUrl) {
    const canvas = document.getElementById(canvasId);
    if (!canvas) return { isEmpty: () => true, toDataURL: () => null };
    const ctx = canvas.getContext('2d');
    let drawing = false;
    let userDrawn = false;
    let normalizedExisting = null;

    function drawImageSrc(src) {
      if (!src) return;
      const rect = canvas.getBoundingClientRect();
      const img = new Image();
      img.onload = () => ctx.drawImage(img, 0, 0, rect.width, 160);
      img.src = src;
    }

    if (existingDataUrl) {
      normalizeSignatureDataUrl(existingDataUrl, (fixed) => {
        normalizedExisting = fixed || existingDataUrl;
        resize();
      });
    }

    function resize() {
      const ratio = window.devicePixelRatio || 1;
      const rect = canvas.getBoundingClientRect();
      const preserve = userDrawn ? exportSignatureCanvas(canvas) : normalizedExisting;
      canvas.width = Math.max(300, Math.floor(rect.width * ratio));
      canvas.height = Math.floor(160 * ratio);
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      ctx.lineWidth = 2.2;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.strokeStyle = '#0f172a';
      paintWhitePad(ctx, rect.width, 160);
      drawImageSrc(preserve);
    }

    resize();
    window.addEventListener('resize', resize);

    if (readonly) {
      if (existingDataUrl) {
        normalizeSignatureDataUrl(existingDataUrl, (fixed) => {
          const rect = canvas.getBoundingClientRect();
          paintWhitePad(ctx, rect.width, 160);
          drawImageSrc(fixed || existingDataUrl);
        });
      }
      return {
        isEmpty: () => !existingDataUrl,
        toDataURL: () => normalizedExisting || existingDataUrl,
        clear: () => {},
      };
    }

    function pos(ev) {
      const rect = canvas.getBoundingClientRect();
      const t = ev.touches ? ev.touches[0] : ev;
      return { x: t.clientX - rect.left, y: t.clientY - rect.top };
    }
    function start(ev) {
      ev.preventDefault();
      drawing = true;
      const p = pos(ev);
      ctx.beginPath();
      ctx.moveTo(p.x, p.y);
    }
    function move(ev) {
      if (!drawing) return;
      ev.preventDefault();
      const p = pos(ev);
      ctx.lineTo(p.x, p.y);
      ctx.stroke();
      userDrawn = true;
    }
    function end(ev) {
      if (!drawing) return;
      ev.preventDefault();
      drawing = false;
    }

    canvas.addEventListener('mousedown', start);
    canvas.addEventListener('mousemove', move);
    canvas.addEventListener('mouseup', end);
    canvas.addEventListener('mouseleave', end);
    canvas.addEventListener('touchstart', start, { passive: false });
    canvas.addEventListener('touchmove', move, { passive: false });
    canvas.addEventListener('touchend', end);

    return {
      isEmpty: () => !userDrawn && !normalizedExisting,
      toDataURL: () => (userDrawn ? exportSignatureCanvas(canvas) : normalizedExisting),
      clear: () => {
        const rect = canvas.getBoundingClientRect();
        paintWhitePad(ctx, rect.width, 160);
        userDrawn = false;
        normalizedExisting = null;
      },
    };
  }

  const padTecnico = setupPad('sig-tecnico', existingFirmaTecnico);
  const padCliente = setupPad('sig-cliente', existingFirmaCliente);

  document.querySelectorAll('[data-clear]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-clear');
      if (id === 'sig-tecnico') padTecnico.clear();
      if (id === 'sig-cliente') padCliente.clear();
    });
  });

  function collectPayload(firmar) {
    const form = document.getElementById('ficha-form');
    const fd = new FormData(form);
    const equipoId = fd.get('equipo_id') || (equipoIdInput ? equipoIdInput.value : null);
    const categorias = Array.from(document.querySelectorAll('input[name="categoria"]:checked')).map((el) => el.value);
    return {
      equipo_id: equipoId,
      tipo: currentTipo(),
      fecha: fd.get('fecha'),
      hora: fd.get('hora'),
      trabajo: fd.get('trabajo'),
      nota: fd.get('nota'),
      dano_descripcion: fd.get('dano_descripcion'),
      realizado_por: fd.get('realizado_por'),
      firmante_cliente: fd.get('firmante_cliente'),
      email_cliente: fd.get('email_cliente'),
      proxima_mantencion: fd.get('proxima_mantencion'),
      rut_cliente: fd.get('rut_cliente'),
      senores: fd.get('senores'),
      direccion: fd.get('direccion'),
      ciudad_comuna: fd.get('ciudad_comuna'),
      telefono_cliente: fd.get('telefono_cliente'),
      contacto_nombre: fd.get('contacto_nombre'),
      version_sw: fd.get('version_sw'),
      motivo_atencion: fd.get('motivo_atencion'),
      categorias,
      fotos: fotos.map((p) => {
        if (p.archivo) return { nombre: p.nombre, archivo: p.archivo };
        if (p.data) return { nombre: p.nombre, data: p.data };
        return null;
      }).filter(Boolean),
      checklist: JSON.stringify(checklist),
      firma_tecnico: padTecnico.toDataURL(),
      firma_cliente: padCliente.toDataURL(),
      guardar_y_firmar: firmar ? 'true' : 'false',
    };
  }

  async function save(firmar) {
    const payload = collectPayload(firmar);
    if (!payload.equipo_id) {
      alert('Selecciona un equipo');
      return;
    }
    if (firmar) {
      if (padTecnico.isEmpty() || padCliente.isEmpty()) {
        alert('Se necesitan ambas firmas (técnico y cliente) para cerrar la ficha');
        return;
      }
      if (!payload.firmante_cliente) {
        alert('Indica el nombre del cliente que firma');
        return;
      }
    }

    const fichaId = document.getElementById('ficha-id')?.value;
    const url = fichaId ? '/mantenciones/' + fichaId : '/mantenciones';
    const method = fichaId ? 'PATCH' : 'POST';

    try {
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        alert(data.error || ('Error ' + res.status));
        return;
      }
      window.location.href = '/mantenciones/' + data.id;
    } catch (e) {
      console.error(e);
      alert('Error de conexión');
    }
  }

  const btnBorrador = document.getElementById('btn-borrador');
  const btnFirmar = document.getElementById('btn-firmar');
  if (btnBorrador) btnBorrador.addEventListener('click', () => save(false));
  if (btnFirmar) btnFirmar.addEventListener('click', () => save(true));

  function renderFotos() {
    const wrap = document.getElementById('fotos-preview');
    if (!wrap) return;
    wrap.innerHTML = fotos.map((p, i) =>
      '<div class="relative">' +
        '<img src="' + (p.url || p.data || '') + '" alt="" class="foto-thumb">' +
        (readonly ? '' : '<button type="button" data-foto="' + i + '" class="absolute top-1 right-1 bg-black/70 text-white text-[10px] px-1.5 py-0.5 rounded">x</button>') +
      '</div>'
    ).join('');
    wrap.querySelectorAll('[data-foto]').forEach((btn) => {
      btn.addEventListener('click', () => {
        fotos.splice(Number(btn.dataset.foto), 1);
        renderFotos();
      });
    });
  }

  function compressImage(file) {
    return new Promise((resolve, reject) => {
      const img = new Image();
      const url = URL.createObjectURL(file);
      img.onload = () => {
        const max = 960;
        let w = img.width;
        let h = img.height;
        if (w > max || h > max) {
          const scale = Math.min(max / w, max / h);
          w = Math.round(w * scale);
          h = Math.round(h * scale);
        }
        const canvas = document.createElement('canvas');
        canvas.width = w;
        canvas.height = h;
        canvas.getContext('2d').drawImage(img, 0, 0, w, h);
        URL.revokeObjectURL(url);
        resolve(canvas.toDataURL('image/jpeg', 0.5));
      };
      img.onerror = reject;
      img.src = url;
    });
  }

  const fotosInput = document.getElementById('fotos-input');
  if (fotosInput && !readonly) {
    fotosInput.addEventListener('change', async (ev) => {
      const files = Array.from(ev.target.files || []);
      for (const file of files) {
        if (fotos.length >= 4) break;
        if (!file.type.startsWith('image/')) continue;
        try {
          const data = await compressImage(file);
          fotos.push({ nombre: file.name.slice(0, 80), data });
        } catch (e) {
          console.error(e);
        }
      }
      ev.target.value = '';
      renderFotos();
    });
  }
  renderFotos();

  toggleTipoUI();
  if (checklist && checklist.length) {
    marcaEl.textContent = selectedEquipoMarca ? ('Marca: ' + selectedEquipoMarca) : '';
    renderChecklist();
  } else if (!readonly && equipoIdInput && equipoIdInput.value) {
    loadProtocoloForMarca(selectedEquipoMarca);
  } else {
    renderChecklist();
  }
})();
</script>
