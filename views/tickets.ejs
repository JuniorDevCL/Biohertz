<%
  const fmtTkDate = (d) => d
    ? new Date(d).toLocaleDateString('es-CL', { day: '2-digit', month: '2-digit', year: '2-digit', timeZone: 'America/Santiago' })
    : '—';
%>
<div class="bh-shell bh-page">
    <div class="bh-head">
        <div class="min-w-0">
            <div class="flex items-center gap-3 flex-wrap">
                <h1 class="text-2xl font-bold text-white tracking-tight">Tickets</h1>
                <span class="bh-chip bg-slate-800 text-slate-200 border border-slate-700">
                    <i class="ph ph-ticket text-sm"></i>
                    Tickets totales: <span class="font-semibold"><%= typeof totalTickets !== 'undefined' ? totalTickets : (tickets && tickets.length ? tickets.length : 0) %></span>
                </span>
            </div>
            <p class="text-slate-400 text-sm mt-1">Gestiona y haz seguimiento de los tickets de servicio.</p>
        </div>
        <div class="bh-head-actions">
            <a href="/tickets/export/csv" class="bh-btn bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700" title="Descargar reporte en CSV">
                <i class="ph ph-download-simple"></i>
                CSV
            </a>
            <button onclick="document.getElementById('new-ticket-modal').classList.remove('hidden')" class="bh-btn bg-blue-600 hover:bg-blue-700 text-white">
                <i class="ph ph-plus"></i>
                Nuevo Ticket
            </button>
        </div>
    </div>

    <div class="bh-panel bg-slate-900 border border-slate-800 shadow-xl">
        <form action="/tickets" method="GET" class="bh-toolbar border-b border-slate-800">
            <div class="bh-search">
                <i class="ph ph-magnifying-glass text-sm text-slate-500"></i>
                <input
                    type="text"
                    name="q"
                    value="<%= typeof query !== 'undefined' ? query : '' %>"
                    placeholder="Buscar por título o descripción"
                    class="bh-ctl bg-slate-950 border border-slate-700 text-white placeholder-slate-500">
            </div>
            <select name="tipo" class="bh-ctl bg-slate-950 border border-slate-700 text-white">
                <option value="">Todos los tipos</option>
                <option value="mantencion_preventiva" <%= queryTipo === 'mantencion_preventiva' ? 'selected' : '' %>>M. Preventiva (MP)</option>
                <option value="mantencion_correctiva" <%= queryTipo === 'mantencion_correctiva' ? 'selected' : '' %>>M. Correctiva (MC)</option>
                <option value="visita_tecnica" <%= queryTipo === 'visita_tecnica' ? 'selected' : '' %>>Visita técnica (VT)</option>
                <option value="reparacion" <%= queryTipo === 'reparacion' ? 'selected' : '' %>>Reparación (R)</option>
                <option value="otro" <%= queryTipo === 'otro' ? 'selected' : '' %>>Otro (O)</option>
            </select>
            <select name="estado_view" class="bh-ctl bg-slate-950 border border-slate-700 text-white">
                <option value="">Todos los estados</option>
                <option value="activos" <%= estadoView === 'activos' ? 'selected' : '' %>>Activos</option>
                <option value="resueltos" <%= estadoView === 'resueltos' ? 'selected' : '' %>>Terminados</option>
            </select>
            <button type="submit" class="bh-btn bg-slate-800 hover:bg-slate-700 text-slate-100 border border-slate-700">
                <i class="ph ph-funnel-simple"></i>
                Filtrar
            </button>
        </form>
        <% if (typeof tickets !== 'undefined' && tickets && tickets.length > 0) { %>
            <div class="overflow-x-auto rounded-b-2xl min-w-0">
                <table class="bh-table text-left text-[13px]">
                    <thead>
                        <tr class="uppercase text-slate-400 font-semibold">
                            <th class="py-2.5 px-3 w-[22%]">Título / Código</th>
                            <th class="py-2.5 px-3 w-[92px]">Estado</th>
                            <th class="py-2.5 px-3 w-[11%]">Asignado</th>
                            <th class="py-2.5 px-3 w-[17%]">Cliente</th>
                            <th class="py-2.5 px-3">Equipo / Modelo / Serie</th>
                            <th class="py-2.5 px-3 w-[90px]">F. inicio</th>
                            <th class="py-2.5 px-3 w-[90px]">F. término</th>
                            <th class="py-2.5 px-2 text-right bh-actions">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800/80">
                        <%
                        const tipoStyles = {
                            mantencion_preventiva: { label: 'MP', cls: 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30' },
                            mantencion_correctiva: { label: 'MC', cls: 'bg-amber-500/15 text-amber-300 border-amber-500/30' },
                            visita_tecnica:        { label: 'VT', cls: 'bg-blue-500/15 text-blue-300 border-blue-500/30' },
                            reparacion:            { label: 'R',  cls: 'bg-orange-500/15 text-orange-300 border-orange-500/30' },
                            otro:                  { label: 'O',  cls: 'bg-slate-500/15 text-slate-300 border-slate-500/30' }
                        };
                        const getTipo = (tipo) => tipoStyles[tipo] || { label: tipo, cls: 'bg-slate-500/15 text-slate-300 border-slate-500/30' };
                        %>
                        <% tickets.forEach(ticket => { %>
                            <tr class="transition-colors group">
                                <td class="py-2 px-3">
                                    <button type="button" class="block text-left w-full min-w-0" onclick="openTicketDetails('<%= ticket.id %>')">
                                        <div class="font-medium text-white truncate group-hover:text-teal-300 transition-colors" title="<%= ticket.titulo %>"><%= ticket.titulo %></div>
                                        <% if (ticket.codigo || ticket.tipo || ticket.garantia) { %>
                                            <div class="bh-sub">
                                                <% if (ticket.codigo) { %>
                                                    <span class="bh-tag font-mono font-medium tracking-wide bg-slate-800 border border-slate-700 text-slate-200"><%= ticket.codigo %></span>
                                                <% } %>
                                                <% if (ticket.tipo) { const ts = getTipo(ticket.tipo); %>
                                                    <span class="bh-tag border <%= ts.cls %>"><%= ts.label %></span>
                                                <% } %>
                                                <% if (ticket.garantia) { %>
                                                    <span class="bh-tag bg-purple-500/20 text-purple-400 border border-purple-500/30">GARANTÍA</span>
                                                <% } %>
                                            </div>
                                        <% } %>
                                    </button>
                                </td>
                                <td class="py-2 px-3">
                                    <span id="ticket-status-badge-<%= ticket.id %>" class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium border <%= (ticket.estado === 'hecho' || ticket.estado === 'terminado') ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/40' : 'bg-amber-500/10 text-amber-400 border-amber-500/40' %>">
                                        <%= (ticket.estado === 'hecho' || ticket.estado === 'terminado') ? 'Terminado' : 'Activo' %>
                                    </span>
                                </td>
                                <td class="py-2 px-3 text-slate-300" title="<%= ticket.asignado_a_nombre || '' %>"><%= ticket.asignado_a_nombre || '—' %></td>
                                <td class="py-2 px-3 text-slate-200" title="<%= ticket.cliente_nombre || '' %>"><%= ticket.cliente_nombre || '—' %></td>
                                <td class="py-2 px-3" title="<%= [ticket.equipo_nombre, ticket.equipo_modelo, ticket.equipo_serie].filter(Boolean).join(' · ') %>">
                                    <div class="text-slate-200 truncate"><%= ticket.equipo_nombre || '—' %><% if (ticket.equipo_modelo) { %><span class="text-slate-400"> · <%= ticket.equipo_modelo %></span><% } %></div>
                                    <% if (ticket.equipo_serie) { %><div class="text-[11px] text-slate-500 truncate">S/N <%= ticket.equipo_serie %></div><% } %>
                                </td>
                                <td class="py-2 px-3 text-slate-400"><%= fmtTkDate(ticket.creado_en) %></td>
                                <td class="py-2 px-3 text-slate-400"><%= fmtTkDate(ticket.terminado_en) %></td>
                                <td class="py-2 px-2 bh-actions">
                                    <div class="flex items-center justify-end gap-1">
                                        <button type="button" onclick="openTicketDetails('<%= ticket.id %>')" class="bh-icon-btn bg-slate-800 hover:bg-slate-700 text-slate-200 border-slate-600/60" title="Ver detalle del ticket">
                                            <i class="ph ph-eye text-sm"></i>
                                        </button>
                                        <details class="bh-menu">
                                            <summary class="bh-icon-btn hover:bg-slate-800 text-slate-400 hover:text-white" title="Más acciones"><i class="ph ph-dots-three-outline-vertical text-sm"></i></summary>
                                            <div class="bh-menu-list bg-slate-900 border border-slate-700">
                                                <button type="button" class="bh-menu-item text-slate-200 hover:bg-slate-800" onclick="openTicketDetails('<%= ticket.id %>')"><i class="ph ph-eye"></i>Ver detalle</button>
                                                <div class="bh-menu-sep bg-slate-700"></div>
                                                <button type="button" class="bh-menu-item text-red-300 hover:bg-red-500/10" onclick="deleteTicket('<%= ticket.id %>')"><i class="ph ph-trash"></i>Eliminar ticket</button>
                                            </div>
                                        </details>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="text-center py-12">
                <div class="text-slate-500 mb-4 text-5xl"><i class="ph ph-ticket"></i></div>
                <p class="text-slate-400 text-lg">No hay tickets registrados.</p>
                <p class="text-slate-500 text-sm">Crea uno nuevo para comenzar.</p>
            </div>
        <% } %>
    </div>
</div>

<!-- Modal Nuevo Ticket -->
<div id="new-ticket-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center z-50 p-4">
    <div class="bg-slate-800 p-6 rounded-2xl w-full max-w-4xl shadow-2xl border border-slate-700 max-h-[92vh] overflow-y-auto">
        <h3 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
            <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-blue-500/20 text-blue-400">
                <i class="ph ph-ticket"></i>
            </span>
            Nuevo Ticket
        </h3>
        <form action="/tickets" method="POST" class="grid grid-cols-12 gap-4">

            <!-- Row 1: Titulo (8) + Tipo (4) -->
            <div class="col-span-8">
                <label class="block text-slate-400 text-sm mb-2">Título</label>
                <input type="text" name="titulo" required class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500">
            </div>
            <div class="col-span-4">
                <label class="block text-slate-400 text-sm mb-2">Tipo de ticket</label>
                <select name="tipo" required class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500 text-sm">
                    <option value="mantencion_preventiva">Mantención Preventiva (MP)</option>
                    <option value="mantencion_correctiva">Mantención Correctiva (MC)</option>
                    <option value="visita_tecnica">Visita Técnica (VT)</option>
                    <option value="reparacion">Reparación (R)</option>
                    <option value="otro">Otro (O)</option>
                </select>
            </div>

            <!-- Row 2: Cliente (4) + Asignado (4) + Garantia (4) -->
            <div class="col-span-4">
                <label class="block text-slate-400 text-sm mb-2">Cliente (Opcional)</label>
                <select name="cliente_id" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500 text-sm">
                    <option value="">Seleccionar Cliente</option>
                    <% if (typeof clientes !== 'undefined') { %>
                        <% clientes.forEach(c => { %>
                            <option value="<%= c.id %>"><%= c.nombre %></option>
                        <% }); %>
                    <% } %>
                </select>
            </div>
            <div class="col-span-4">
                <label class="block text-slate-400 text-sm mb-2">Asignar a</label>
                <select name="asignado_a" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500 text-sm">
                    <option value="">Seleccionar Usuario</option>
                    <% if (typeof usuarios !== 'undefined') { %>
                        <% usuarios.forEach(u => { %>
                            <option value="<%= u.id %>"><%= u.nombre %></option>
                        <% }); %>
                    <% } %>
                </select>
            </div>
            <div class="col-span-4">
                <label class="block text-slate-400 text-sm mb-2">¿Garantía?</label>
                <select name="garantia" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500 text-sm">
                    <option value="no">No</option>
                    <option value="si">Sí</option>
                </select>
            </div>

            <!-- Row 3: Lugar (6) + Telefono (6) -->
            <div class="col-span-6">
                <label class="block text-slate-400 text-sm mb-2">Contacto</label>
                <input type="text" name="lugar_instalacion" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500 text-sm">
            </div>
            <div class="col-span-6">
                <label class="block text-slate-400 text-sm mb-2">Número de teléfono</label>
                <input type="text" name="telefono_contacto" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500 text-sm">
            </div>

            <!-- Row 4: Equipo (12) -->
            <div class="col-span-12 border border-slate-700 rounded-lg p-3 bg-slate-800/50">
                <h4 class="text-sm font-semibold text-slate-300 mb-3 flex items-center gap-2">
                    <i class="ph ph-desktop"></i> Datos del Equipo
                </h4>
                <div class="grid grid-cols-3 gap-4">
                    <div>
                        <label class="block text-slate-400 text-xs mb-1">Número de serie</label>
                        <div class="relative">
                            <input type="text" name="numero_serie" id="input_serie" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500 text-sm" placeholder="Buscar/Crear...">
                            <div id="serie_loading" class="hidden absolute right-3 top-2.5 text-blue-400">
                                <i class="ph ph-spinner animate-spin"></i>
                            </div>
                        </div>
                        <p id="serie_msg" class="text-[10px] mt-1 h-4"></p>
                    </div>
                    <div>
                        <label class="block text-slate-400 text-xs mb-1">Nombre del equipo</label>
                        <input type="text" name="equipo_nombre" id="input_equipo_nombre" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500 text-sm">
                    </div>
                    <div>
                        <label class="block text-slate-400 text-xs mb-1">Modelo</label>
                        <input type="text" name="equipo_modelo" id="input_equipo_modelo" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500 text-sm">
                    </div>
                    <div>
                        <label class="block text-slate-400 text-xs mb-1">Marca</label>
                        <input type="text" name="equipo_marca" id="input_equipo_marca" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500 text-sm">
                    </div>
                    <div>
                        <label class="block text-slate-400 text-xs mb-1">Ubicación</label>
                        <input type="text" name="equipo_ubicacion" id="input_equipo_ubicacion" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500 text-sm">
                    </div>
                </div>
            </div>

            <!-- Row 5: Descripcion (8) + Notificaciones (4) -->
            <div class="col-span-8">
                <label class="block text-slate-400 text-sm mb-2">Descripción</label>
                <textarea name="descripcion" rows="5" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-white focus:outline-none focus:border-blue-500"></textarea>
            </div>

            <div class="col-span-4 flex flex-col">
                <label class="block text-slate-400 text-sm mb-2">Notificar a otros (Copia)</label>
                <div class="bg-slate-900 border border-slate-700 rounded p-2 flex-1 overflow-y-auto max-h-[132px]">
                    <% if (typeof usuarios !== 'undefined') { %>
                        <% usuarios.forEach(u => { %>
                            <div class="flex items-center gap-2 mb-1 last:mb-0">
                                <input type="checkbox" name="notificar_a" value="<%= u.id %>" id="notify_<%= u.id %>" class="rounded border-slate-700 bg-slate-800 text-blue-600 focus:ring-blue-500">
                                <label for="notify_<%= u.id %>" class="text-sm text-slate-300 cursor-pointer select-none truncate"><%= u.nombre %></label>
                            </div>
                        <% }); %>
                    <% } %>
                </div>
            </div>

            <div class="col-span-12 flex justify-end gap-3 mt-2 border-t border-slate-700/50 pt-4">
                <button type="button" onclick="document.getElementById('new-ticket-modal').classList.add('hidden')" class="px-4 py-2 text-slate-300 hover:text-white">Cancelar</button>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg font-medium shadow-lg shadow-blue-500/20">Crear Ticket</button>
            </div>
        </form>
    </div>
</div>

<script>
const ticketPageParams = new URLSearchParams(window.location.search);
if (ticketPageParams.get('new')) {
    const modal = document.getElementById('new-ticket-modal');
    if (modal) modal.classList.remove('hidden');
}
const openTicketId = ticketPageParams.get('open');
if (openTicketId) {
    document.addEventListener('DOMContentLoaded', () => openTicketDetails(openTicketId));
}

document.addEventListener('DOMContentLoaded', () => {
    const inputSerie = document.getElementById('input_serie');
    const inputNombre = document.getElementById('input_equipo_nombre');
    const inputModelo = document.getElementById('input_equipo_modelo');
    const inputMarca = document.getElementById('input_equipo_marca');
    const inputUbicacion = document.getElementById('input_equipo_ubicacion');
    const msgSerie = document.getElementById('serie_msg');
    const loadingSerie = document.getElementById('serie_loading');
    let searchTimeout;

    if (inputSerie) {
        inputSerie.addEventListener('input', (e) => {
            const val = e.target.value.trim();
            clearTimeout(searchTimeout);

            if (val.length < 3) {
                if (msgSerie) msgSerie.textContent = '';
                if (loadingSerie) loadingSerie.classList.add('hidden');
                return;
            }

            if (loadingSerie) loadingSerie.classList.remove('hidden');
            if (msgSerie) {
                msgSerie.textContent = 'Buscando...';
                msgSerie.className = 'text-[10px] mt-1 h-4 text-blue-400';
            }

            searchTimeout = setTimeout(async () => {
                try {
                    const res = await fetch(`/equipos?serie=${encodeURIComponent(val)}`, {
                        headers: { 'Accept': 'application/json' }
                    });
                    if (res.ok) {
                        const data = await res.json();
                        const equipos = data.equipos || [];
                        const norm = (s) => (s || '').toString().trim().toLowerCase();
                        const target = norm(val);
                        let exact = equipos.find(eq => norm(eq.numero_serie) === target);
                        if (!exact && equipos.length === 1) {
                            exact = equipos[0];
                        }

                        if (exact) {
                            if (inputNombre) inputNombre.value = exact.nombre || '';
                            if (inputModelo) inputModelo.value = exact.modelo || '';
                            if (inputMarca) inputMarca.value = exact.marca || '';
                            if (inputUbicacion) inputUbicacion.value = exact.ubicacion || '';
                            if (msgSerie) {
                                msgSerie.textContent = 'Equipo encontrado. Datos cargados.';
                                msgSerie.className = 'text-[10px] mt-1 h-4 text-emerald-400';
                            }
                        } else {
                            if (msgSerie) {
                                msgSerie.textContent = 'Equipo no encontrado. Se creará uno nuevo.';
                                msgSerie.className = 'text-[10px] mt-1 h-4 text-orange-400';
                            }
                        }
                    }
                } catch (err) {
                    console.error(err);
                    if (msgSerie) {
                        msgSerie.textContent = 'Error buscando equipo.';
                        msgSerie.className = 'text-[10px] mt-1 h-4 text-red-400';
                    }
                } finally {
                    if (loadingSerie) loadingSerie.classList.add('hidden');
                }
            }, 500);
        });
    }
});

async function deleteTicket(id) {
    const confirmed = confirm('¿Seguro que deseas eliminar este ticket? Esta acción no se puede deshacer.');
    if (!confirmed) return;
    try {
        const res = await fetch('/tickets/' + id, { method: 'DELETE' });
        if (res.ok) {
            window.location.reload();
        } else {
            alert('Error al eliminar ticket');
        }
    } catch (e) {
        console.error(e);
        alert('Error de conexión');
    }
}
</script>
<%- include('partials/overlay_stack') %>
<%- include('partials/detalle_equipo_modal') %>
<%- include('partials/cliente_relacion_modal') %>
<%- include('partials/ticket_details_modal') %>
