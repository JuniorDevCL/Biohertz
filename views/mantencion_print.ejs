<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Atención a clientes Nº <%= String(ficha.id).padStart(5, '0') %> — Biohertz</title>
  <style>
    :root {
      --ink: #1a1a1a;
      --muted: #555;
      --line: #222;
      --orange: #e8771a;
      --bg: #d6d6d6;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      color: var(--ink);
      background: var(--bg);
      font-size: 9.5pt;
      line-height: 1.25;
    }
    .toolbar {
      position: sticky;
      top: 0;
      z-index: 10;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      background: #111;
      color: #eee;
    }
    .toolbar a, .toolbar button {
      font: inherit;
      cursor: pointer;
      border-radius: 8px;
      padding: 8px 12px;
      text-decoration: none;
      border: 1px solid #444;
      background: #222;
      color: #eee;
    }
    .toolbar .primary {
      background: var(--orange);
      color: #111;
      border: none;
      font-weight: 700;
    }
    .sheet-wrap { padding: 20px 12px 40px; display: flex; justify-content: center; }
    .sheet {
      width: 210mm;
      max-width: 100%;
      background: #fff;
      border: 1px solid #999;
      padding: 8mm 10mm 8mm;
    }
    .head {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 12px;
      margin-bottom: 6px;
    }
    .logo-box {
      display: inline-flex;
      align-items: center;
      line-height: 0;
    }
    .logo-box img {
      height: 52px;
      width: auto;
      display: block;
    }
    .title-bar {
      display: flex;
      align-items: stretch;
      border: 1.5px solid #000;
      margin-bottom: 0;
    }
    .title-bar .t {
      flex: 1;
      background: #111;
      color: #fff;
      font-weight: 800;
      letter-spacing: 0.08em;
      font-size: 11pt;
      padding: 6px 10px;
      text-transform: uppercase;
    }
    .title-bar .n {
      min-width: 140px;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 8px;
      padding: 4px 10px;
      font-weight: 700;
      border-left: 1.5px solid #000;
    }
    .title-bar .n span { color: var(--orange); font-size: 12pt; }
    table.grid {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
    }
    table.grid td {
      border: 1px solid #000;
      padding: 4px 6px;
      vertical-align: top;
    }
    .lbl {
      font-size: 7.2pt;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: #111;
    }
    .val {
      font-size: 9.5pt;
      min-height: 1.15em;
      margin-top: 1px;
    }
    .cats {
      width: 168px;
    }
    .cat {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 8pt;
      font-weight: 700;
      text-transform: uppercase;
      padding: 1px 0;
    }
    .boxx {
      width: 11px;
      height: 11px;
      border: 1.4px solid #000;
      display: inline-grid;
      place-items: center;
      font-size: 9px;
      font-weight: 800;
      flex-shrink: 0;
    }
    .boxx.on { background: #111; color: #fff; }
    .desc {
      min-height: 92px;
      white-space: pre-wrap;
      font-size: 9.5pt;
    }
    .checks {
      width: 100%;
      border-collapse: collapse;
    }
    .checks td {
      border: 1px solid #000;
      padding: 3px 6px;
      font-size: 8.2pt;
      vertical-align: top;
    }
    .checks .n { width: 22px; text-align: center; font-weight: 800; }
    .photos {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-top: 6px;
    }
    .photos img {
      width: 100%;
      max-height: 160px;
      object-fit: contain;
      border: 1px solid #000;
      background: #fafafa;
    }
    .sigs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      margin-top: 8px;
    }
    .sig {
      border: 1.5px solid #000;
      min-height: 108px;
      padding: 6px 8px;
      display: flex;
      flex-direction: column;
    }
    .sig + .sig { border-left: none; }
    .sig .who { font-size: 7.5pt; font-weight: 800; text-transform: uppercase; }
    .sig img { max-height: 58px; max-width: 100%; object-fit: contain; margin: 8px auto; background: #fff; }
    .sig .name { margin-top: auto; font-size: 9pt; font-weight: 700; border-top: 1px solid #000; padding-top: 4px; }
    .foot {
      margin-top: 8px;
      border: 1.5px solid #000;
      padding: 5px 8px;
      display: flex;
      justify-content: space-between;
      gap: 10px;
      font-size: 8pt;
      font-weight: 700;
    }
    @media print {
      @page { size: A4; margin: 8mm; }
      body { background: #fff; }
      .toolbar { display: none !important; }
      .sheet-wrap { padding: 0; }
      .sheet { width: auto; border: none; padding: 0; }
    }
    @media (max-width: 720px) {
      .photos, .sigs { grid-template-columns: 1fr; }
      .sheet { padding: 12px; }
    }
  </style>
</head>
<body>
  <%
    const f = ficha;
    const catsList = typeof categoriasAtencion !== 'undefined' && categoriasAtencion ? categoriasAtencion : [];
    const selected = Array.isArray(f.categorias) ? f.categorias.map(String) : [];
    const fechaTxt = f.fecha
      ? new Date(f.fecha).toLocaleDateString('es-CL', { timeZone: 'America/Santiago' })
      : '—';
    const items = Array.isArray(f.checklist) ? f.checklist : [];
    const fotos = Array.isArray(f.fotos) ? f.fotos : [];
    const nro = String(f.id).padStart(5, '0');
    const senores = f.senores || f.equipo_cliente || f.cliente_nombre || '—';
  %>

  <div class="toolbar no-print">
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <% if (typeof portalBack !== 'undefined' && portalBack) { %>
        <a href="<%= portalBack %>">← Volver al portal</a>
      <% } else { %>
        <a href="/mantenciones">← Volver</a>
      <% } %>
    </div>
    <button type="button" class="primary" onclick="window.print()">Imprimir / Guardar PDF</button>
  </div>

  <div class="sheet-wrap">
    <article class="sheet">
      <header class="head">
        <div class="logo-box">
          <img src="/img/biohertz-logo.png" alt="Biohertz Medical Systems" />
        </div>
      </header>

      <div class="title-bar">
        <div class="t">Atención a clientes</div>
        <div class="n">Nº <span><%= nro %></span></div>
      </div>

      <table class="grid">
        <tr>
          <td style="width:28%">
            <div class="lbl">RUT</div>
            <div class="val"><%= f.rut_cliente || '—' %></div>
          </td>
          <td style="width:22%">
            <div class="lbl">Fecha</div>
            <div class="val"><%= fechaTxt %></div>
          </td>
          <td rowspan="5" class="cats">
            <% catsList.forEach(function(c) { %>
              <div class="cat">
                <span class="boxx <%= selected.includes(c.id) ? 'on' : '' %>"><%= selected.includes(c.id) ? '✓' : '' %></span>
                <%= c.label %>
              </div>
            <% }) %>
          </td>
        </tr>
        <tr>
          <td colspan="2">
            <div class="lbl">Señor(es)</div>
            <div class="val"><%= senores %></div>
          </td>
        </tr>
        <tr>
          <td>
            <div class="lbl">Dirección</div>
            <div class="val"><%= f.direccion || '—' %></div>
          </td>
          <td>
            <div class="lbl">Ciudad - Comuna</div>
            <div class="val"><%= f.ciudad_comuna || '—' %></div>
          </td>
        </tr>
        <tr>
          <td>
            <div class="lbl">Teléfono</div>
            <div class="val"><%= f.telefono_cliente || '—' %></div>
          </td>
          <td>
            <div class="lbl">E-mail</div>
            <div class="val"><%= f.email_cliente || '—' %></div>
          </td>
        </tr>
        <tr>
          <td colspan="2">
            <div class="lbl">Contacto</div>
            <div class="val"><%= f.contacto_nombre || f.firmante_cliente || '—' %></div>
          </td>
        </tr>
      </table>

      <table class="grid" style="margin-top:-1px">
        <tr>
          <td>
            <div class="lbl">Equipo</div>
            <div class="val"><%= f.equipo_nombre || '—' %></div>
          </td>
          <td>
            <div class="lbl">Marca</div>
            <div class="val"><%= f.equipo_marca || '—' %></div>
          </td>
          <td>
            <div class="lbl">Modelo</div>
            <div class="val"><%= f.equipo_modelo || '—' %></div>
          </td>
          <td>
            <div class="lbl">Versión S/W</div>
            <div class="val"><%= f.version_sw || '—' %></div>
          </td>
          <td>
            <div class="lbl">N/S</div>
            <div class="val"><%= f.equipo_serie || '—' %></div>
          </td>
        </tr>
        <tr>
          <td colspan="5">
            <div class="lbl">Motivo de atención</div>
            <div class="val"><%= f.motivo_atencion || (f.tipo === 'correctiva' ? 'Reparación' : 'Mantención preventiva') %></div>
          </td>
        </tr>
        <tr>
          <td colspan="5">
            <div class="lbl">Descripción</div>
            <div class="desc"><%= f.trabajo || f.dano_descripcion || '—' %><% if (f.nota) { %>

<%= f.nota %><% } %></div>
          </td>
        </tr>
      </table>

      <% if (f.tipo !== 'correctiva' && items.length) { %>
        <table class="checks" style="margin-top:-1px">
          <tr>
            <td colspan="2" class="lbl" style="padding:5px 6px">Checklist mantención preventiva</td>
          </tr>
          <% items.forEach(function(it, i) { %>
            <tr>
              <td class="n"><%= i + 1 %></td>
              <td>
                <span class="boxx <%= it.checked ? 'on' : '' %>" style="margin-right:6px"><%= it.checked ? '✓' : '' %></span>
                <%= it.label || '' %>
              </td>
            </tr>
          <% }) %>
        </table>
      <% } %>

      <% if (fotos.length) { %>
        <table class="grid" style="margin-top:-1px">
          <tr>
            <td>
              <div class="lbl">Registro fotográfico</div>
              <div class="photos">
                <% fotos.forEach(function(p) { %>
                  <img src="<%= p.url || p.data %>" alt="<%= p.nombre || 'foto' %>" />
                <% }) %>
              </div>
            </td>
          </tr>
        </table>
      <% } %>

      <% if (f.proxima_mantencion) { %>
        <table class="grid" style="margin-top:-1px">
          <tr>
            <td>
              <div class="lbl">Próxima mantención</div>
              <div class="val"><%= new Date(f.proxima_mantencion).toLocaleDateString('es-CL', { timeZone: 'America/Santiago' }) %></div>
            </td>
          </tr>
        </table>
      <% } %>

      <div class="sigs">
        <div class="sig">
          <div class="who">Nombre y firma cliente</div>
          <% if (f.firma_cliente) { %>
            <img src="<%= f.firma_cliente %>" alt="Firma cliente" />
          <% } %>
          <div class="name"><%= f.firmante_cliente || f.contacto_nombre || '—' %></div>
        </div>
        <div class="sig">
          <div class="who">Nombre y firma servicio técnico</div>
          <% if (f.firma_tecnico) { %>
            <img src="<%= f.firma_tecnico %>" alt="Firma técnico" />
          <% } %>
          <div class="name"><%= f.realizado_por || '—' %></div>
        </div>
      </div>

      <div class="foot">
        <span>servicio@biohertz.cl</span>
        <span>www.biohertz.cl</span>
        <span>+56 9 3262 2163</span>
      </div>
    </article>
  </div>
  <script>
    (function () {
      function normalizeSigImg(img) {
        if (!img || !img.src || img.dataset.sigFixed) return;
        var probe = new Image();
        probe.onload = function () {
          var w = probe.naturalWidth || 300;
          var h = probe.naturalHeight || 160;
          var c = document.createElement('canvas');
          c.width = w;
          c.height = h;
          var ctx = c.getContext('2d');
          ctx.drawImage(probe, 0, 0);
          var sample = ctx.getImageData(0, 0, Math.min(w, 80), Math.min(h, 80)).data;
          var dark = 0;
          for (var i = 0; i < sample.length; i += 4) {
            if (sample[i] < 72 && sample[i + 1] < 72 && sample[i + 2] < 72) dark++;
          }
          if (dark <= sample.length / 20) return;
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(0, 0, w, h);
          ctx.filter = 'invert(1)';
          ctx.drawImage(probe, 0, 0);
          img.src = c.toDataURL('image/png');
          img.dataset.sigFixed = '1';
        };
        probe.src = img.src;
      }
      document.querySelectorAll('.sig img').forEach(function (img) {
        if (img.complete) normalizeSigImg(img);
        else img.addEventListener('load', function () { normalizeSigImg(img); });
      });
    })();
  </script>
</body>
</html>
