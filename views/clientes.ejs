<div class="bh-shell bh-page">
    <div class="bh-head">
        <div class="min-w-0">
            <div class="flex items-center gap-3 flex-wrap">
                <h1 class="text-2xl font-bold text-white tracking-tight">Clientes</h1>
                <span class="bh-chip bg-slate-800 text-slate-200 border border-slate-700">
                    <i class="ph ph-users text-sm"></i>
                    Clientes totales: <span class="font-semibold"><%= typeof totalClientes !== 'undefined' ? totalClientes : (clientes && clientes.length ? clientes.length : 0) %></span>
                </span>
            </div>
            <p class="text-slate-400 text-sm mt-1">Gestiona y busca rápidamente todos tus clientes.</p>
        </div>
        <div class="bh-head-actions">
            <button onclick="document.getElementById('new-client-modal').classList.remove('hidden')" class="bh-btn bg-blue-600 hover:bg-blue-700 text-white">
                <i class="ph ph-plus"></i> Nuevo Cliente
            </button>
        </div>
    </div>

    <div class="bh-panel bg-slate-900 border border-slate-800 shadow-xl">
        <form action="/clientes" method="GET" class="bh-toolbar border-b border-slate-800">
            <div class="bh-search">
                <i class="ph ph-magnifying-glass text-sm text-slate-500"></i>
                <input
                    type="text"
                    name="q"
                    value="<%= typeof query !== 'undefined' ? query : '' %>"
                    placeholder="Buscar por razón social, RUT o correo"
                    class="bh-ctl bg-slate-950 border border-slate-700 text-white placeholder-slate-500">
            </div>
            <button type="submit" class="bh-btn bg-slate-800 hover:bg-slate-700 text-slate-100 border border-slate-700">
                <i class="ph ph-funnel-simple"></i>
                Buscar
            </button>
        </form>
        <% if (typeof clientes !== 'undefined' && clientes && clientes.length > 0) { %>
            <div class="overflow-x-auto rounded-b-2xl min-w-0">
                <table class="bh-table text-left text-[13px]">
                    <thead>
                        <tr class="uppercase text-slate-400 font-semibold">
                            <th class="py-2.5 px-3 w-[26%]">Razón social</th>
                            <th class="py-2.5 px-3 w-[120px]">RUT</th>
                            <th class="py-2.5 px-3 w-[22%]">Correo</th>
                            <th class="py-2.5 px-3">Teléfono</th>
                            <th class="py-2.5 px-3">Ciudad</th>
                            <th class="py-2.5 px-3 w-[120px]">Fecha Registro</th>
                            <th class="py-2.5 px-2 text-right bh-actions">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800/80">
                        <% clientes.forEach(cliente => { %>
                            <tr class="transition-colors group">
                                <td class="py-2 px-3 font-medium text-white" title="<%= cliente.nombre %>"><a href="/clientes/<%= cliente.id %>" class="hover:text-teal-300 transition-colors"><%= cliente.nombre %></a></td>
                                <td class="py-2 px-3 text-slate-300" title="<%= cliente.rut || '' %>"><%= cliente.rut || '—' %></td>
                                <td class="py-2 px-3 text-slate-300" title="<%= cliente.email || '' %>">
                                    <% if (cliente.email) { %>
                                        <i class="ph ph-envelope text-slate-500 mr-1"></i><%= cliente.email %>
                                    <% } else { %>
                                        <span class="text-slate-500">—</span>
                                    <% } %>
                                </td>
                                <td class="py-2 px-3 text-slate-300" title="<%= cliente.telefono || '' %>"><%= cliente.telefono || '—' %></td>
                                <td class="py-2 px-3 text-slate-300" title="<%= cliente.ciudad || cliente.ubicacion || '' %>"><%= cliente.ciudad || cliente.ubicacion || '—' %></td>
                                <td class="py-2 px-3 text-slate-400"><%= cliente.creado_en ? new Date(cliente.creado_en).toLocaleDateString('es-CL', { day: '2-digit', month: '2-digit', year: '2-digit', timeZone: 'America/Santiago' }) : '—' %></td>
                                <td class="py-2 px-2 bh-actions">
                                    <div class="flex items-center justify-end gap-1">
                                        <a href="/clientes/<%= cliente.id %>" class="bh-icon-btn bg-slate-800 hover:bg-slate-700 text-slate-200 border-slate-600/60" title="Ver equipos asignados">
                                            <i class="ph ph-desktop text-sm"></i>
                                        </a>
                                        <details class="bh-menu">
                                            <summary class="bh-icon-btn hover:bg-slate-800 text-slate-400 hover:text-white" title="Más acciones"><i class="ph ph-dots-three-outline-vertical text-sm"></i></summary>
                                            <div class="bh-menu-list bg-slate-900 border border-slate-700">
                                                <a href="/clientes/<%= cliente.id %>" class="bh-menu-item text-slate-200 hover:bg-slate-800"><i class="ph ph-desktop"></i>Ver equipos asignados</a>
                                                <button type="button" class="bh-menu-item text-slate-200 hover:bg-slate-800" onclick="openEditModal('<%= cliente.id %>')"><i class="ph ph-pencil-simple"></i>Editar cliente</button>
                                                <div class="bh-menu-sep bg-slate-700"></div>
                                                <button type="button" class="bh-menu-item text-red-300 hover:bg-red-500/10" onclick="deleteClient('<%= cliente.id %>')"><i class="ph ph-trash"></i>Eliminar cliente</button>
                                            </div>
                                        </details>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="text-center py-12">
                <div class="text-slate-500 mb-4 text-5xl"><i class="ph ph-users"></i></div>
                <p class="text-slate-400 text-lg">No hay clientes registrados.</p>
                <p class="text-slate-500 text-sm">Agrega un nuevo cliente para comenzar.</p>
            </div>
        <% } %>
    </div>
</div>

<script>
async function deleteClient(id) {
    const confirmed = confirm('¿Seguro que deseas eliminar este cliente? Esta acción no se puede deshacer.');
    if (!confirmed) return;
    try {
        const res = await fetch('/clientes/' + id, { method: 'DELETE' });
        if (res.ok) {
            window.location.reload();
        } else {
            alert('Error al eliminar cliente');
        }
    } catch (e) {
        console.error(e);
        alert('Error de conexión');
    }
}

function openEditModal(id) {
    document.getElementById('edit-id').value = id;

    const list = document.getElementById('contacts-list');
    if (list) {
        list.innerHTML = '<p class="text-slate-500 text-sm italic text-center">Cargando contactos...</p>';
        document.getElementById('add-contact-form').classList.add('hidden');
        loadContacts(id);
    }

    fetch('/clientes/' + id, { headers: { Accept: 'application/json' } })
        .then(function (res) { return res.ok ? res.json() : null; })
        .then(function (payload) {
            const cliente = payload && payload.cliente ? payload.cliente : payload;
            const equipos = payload && Array.isArray(payload.equipos) ? payload.equipos : [];
            fillClienteForm('edit-cli-', cliente || {}, equipos[0] || {});
        })
        .catch(function (e) { console.error(e); });

    document.getElementById('edit-client-modal').classList.remove('hidden');
}

async function loadContacts(clientId) {
    const list = document.getElementById('contacts-list');
    try {
        const res = await fetch(`/clientes/${clientId}/contactos`);
        if (res.ok) {
            const contacts = await res.json();
            renderContacts(contacts);
        } else {
            list.innerHTML = '<p class="text-red-400 text-sm">Error al cargar contactos</p>';
        }
    } catch (e) {
        console.error(e);
        list.innerHTML = '<p class="text-red-400 text-sm">Error de conexión</p>';
    }
}

function renderContacts(contacts) {
    const list = document.getElementById('contacts-list');
    if (contacts.length === 0) {
        list.innerHTML = '<p class="text-slate-500 text-sm text-center">No hay contactos registrados</p>';
        return;
    }
    
    list.innerHTML = contacts.map(c => `
        <div class="bg-slate-900/50 p-2 rounded border border-slate-700/50 flex justify-between items-start">
            <div>
                <div class="text-sm font-medium text-white">${c.nombre} <span class="text-slate-500 text-xs font-normal">(${c.cargo || 'Sin cargo'})</span></div>
                <div class="text-xs text-slate-400 flex flex-col">
                    ${c.email ? `<span><i class="ph ph-envelope"></i> ${c.email}</span>` : ''}
                    ${c.telefono ? `<span><i class="ph ph-phone"></i> ${c.telefono}</span>` : ''}
                </div>
            </div>
            <button type="button" onclick="deleteContact(${c.id})" class="text-red-400 hover:text-red-300 p-1">
                <i class="ph ph-trash"></i>
            </button>
        </div>
    `).join('');
}

async function saveNewContact() {
    const clientId = document.getElementById('edit-id').value;
    const nombre = document.getElementById('new-contact-nombre').value;
    const cargo = document.getElementById('new-contact-cargo').value;
    const email = document.getElementById('new-contact-email').value;
    const telefono = document.getElementById('new-contact-telefono').value;

    if (!nombre) return alert('El nombre es obligatorio');

    try {
        const res = await fetch(`/clientes/${clientId}/contactos`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ nombre, cargo, email, telefono })
        });
        
        if (res.ok) {
            // Clear inputs
            document.getElementById('new-contact-nombre').value = '';
            document.getElementById('new-contact-cargo').value = '';
            document.getElementById('new-contact-email').value = '';
            document.getElementById('new-contact-telefono').value = '';
            document.getElementById('add-contact-form').classList.add('hidden');
            
            // Reload contacts
            loadContacts(clientId);
        } else {
            alert('Error al guardar contacto');
        }
    } catch (e) {
        console.error(e);
        alert('Error de conexión');
    }
}

async function deleteContact(contactId) {
    if (!confirm('¿Eliminar contacto?')) return;
    const clientId = document.getElementById('edit-id').value;
    
    try {
        const res = await fetch(`/clientes/${clientId}/contactos/${contactId}`, { method: 'DELETE' });
        if (res.ok) {
            loadContacts(clientId);
        } else {
            alert('Error al eliminar contacto');
        }
    } catch (e) {
        console.error(e);
        alert('Error de conexión');
    }
}

async function submitEditClient(e) {
    e.preventDefault();
    const id = document.getElementById('edit-id').value;
    const data = collectClienteForm('edit-cli-', e.target);

    try {
        const res = await fetch(`/clientes/${id}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        if (res.ok) {
            window.location.reload();
        } else {
            const err = await res.json();
            alert('Error al actualizar: ' + (err.error || 'Error desconocido'));
        }
    } catch (error) {
        console.error(error);
        alert('Error de conexión');
    }
}
</script>

<!-- Modal Editar Cliente -->
<div id="edit-client-modal" class="fixed inset-0 bg-black/50 hidden flex items-center justify-center z-50 p-4">
    <div class="bg-slate-800 p-6 rounded-xl w-full max-w-2xl shadow-2xl border border-slate-700 overflow-y-auto max-h-[90vh]">
        <h3 class="text-xl font-bold text-white mb-4">Editar Cliente</h3>
        <form onsubmit="submitEditClient(event)">
            <input type="hidden" id="edit-id" name="id">
            <%- include('partials/cliente_form_fields', { idPrefix: 'edit-cli-', cliente: {}, equipo: {} }) %>

            <div class="mt-6 border-t border-slate-700 pt-4">
                <div class="flex items-center justify-between mb-4">
                    <h4 class="text-sm font-semibold text-white">Contactos</h4>
                    <button type="button" onclick="document.getElementById('add-contact-form').classList.toggle('hidden')" class="text-xs bg-blue-600 hover:bg-blue-500 text-white px-2 py-1 rounded">
                        + Agregar
                    </button>
                </div>
                <div id="add-contact-form" class="hidden mb-4 bg-slate-900 p-3 rounded border border-slate-700">
                    <div class="grid grid-cols-2 gap-2 mb-2">
                        <input type="text" id="new-contact-nombre" data-texto-cliente="1" placeholder="Nombre" class="bg-slate-800 border border-slate-700 rounded p-1 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-blue-500">
                        <input type="text" id="new-contact-cargo" data-texto-cliente="1" placeholder="Cargo" class="bg-slate-800 border border-slate-700 rounded p-1 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-blue-500">
                        <input type="email" id="new-contact-email" placeholder="Email" class="bg-slate-800 border border-slate-700 rounded p-1 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-blue-500">
                        <input type="text" id="new-contact-telefono" placeholder="Teléfono" class="bg-slate-800 border border-slate-700 rounded p-1 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-blue-500">
                    </div>
                    <div class="flex justify-end">
                        <button type="button" onclick="saveNewContact()" class="bg-emerald-600 hover:bg-emerald-500 text-white px-3 py-1 rounded text-xs">Guardar Contacto</button>
                    </div>
                </div>
                <div id="contacts-list" class="space-y-2 max-h-40 overflow-y-auto pr-1 custom-scrollbar">
                    <p class="text-slate-500 text-sm italic text-center">Cargando contactos...</p>
                </div>
            </div>

            <div class="flex justify-end gap-3 mt-6 pt-4 border-t border-slate-700">
                <button type="button" onclick="document.getElementById('edit-client-modal').classList.add('hidden')" class="px-4 py-2 text-slate-300 hover:text-white">Cancelar</button>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded">Guardar Cambios</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Nuevo Cliente -->
<div id="new-client-modal" class="fixed inset-0 bg-black/50 hidden flex items-center justify-center z-50 p-4">
    <div class="bg-slate-800 p-6 rounded-xl w-full max-w-2xl shadow-2xl border border-slate-700 overflow-y-auto max-h-[90vh]">
        <h3 class="text-xl font-bold text-white mb-4">Nuevo Cliente</h3>
        <form action="/clientes" method="POST">
            <%- include('partials/cliente_form_fields', { idPrefix: 'new-cli-', cliente: {}, equipo: {} }) %>
            <div class="flex justify-end gap-3 mt-6">
                <button type="button" onclick="document.getElementById('new-client-modal').classList.add('hidden')" class="px-4 py-2 text-slate-300 hover:text-white">Cancelar</button>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded">Guardar</button>
            </div>
        </form>
    </div>
</div>

<%- include('partials/cliente_equipo_script') %>
<script>
document.addEventListener('DOMContentLoaded', function () {
    bindGarantiaBlock('new-cli-');
    bindSerieLookup('new-cli-');
    bindGarantiaBlock('edit-cli-');
    bindSerieLookup('edit-cli-');
});
</script>
