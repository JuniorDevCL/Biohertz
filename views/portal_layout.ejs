<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Portal BIODATA' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="icon" href="/img/biodata-logo.svg" type="image/svg+xml">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
  <link href="/theme.css" rel="stylesheet">
  <style>
    body { font-family: "Plus Jakarta Sans", "Segoe UI", sans-serif; background: #070b12; color: #e8eef8; }
  </style>
</head>
<body class="min-h-screen">
  <header class="border-b border-slate-800/80 bg-slate-950/70 backdrop-blur sticky top-0 z-20">
    <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between gap-3">
      <a href="/portal" class="flex items-center gap-3 min-w-0">
        <img src="/img/biodata-logo.svg" alt="BIODATA" class="h-9 w-9 rounded-lg shrink-0">
        <div class="min-w-0">
          <div class="text-sm font-bold tracking-[0.14em] text-white">BIO<span style="color:#2dd4bf">DATA</span></div>
          <div class="text-[11px] text-slate-400 truncate">Portal · <%= portalUser.cliente_nombre || 'Cliente' %></div>
        </div>
      </a>
      <div class="flex items-center gap-3 text-sm">
        <span class="hidden sm:inline text-slate-400 truncate max-w-[180px]"><%= portalUser.email %></span>
        <a href="/portal/logout" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 text-xs">
          Salir
        </a>
      </div>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-4 py-6 sm:py-8">
    <%- body %>
  </main>
</body>
</html>
